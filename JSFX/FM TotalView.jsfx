last_mouse_cap = mouse_cap;

gfx_r = bg_r; gfx_g = bg_g; gfx_b = bg_b; gfx_a = 1;
gfx_rect(0, 0, gfx_w, gfx_h);

// --- OSCILLOSCOPE: simple direct waveform renderer ---
// Keep the legacy 50 ms look-back for FFT/goniometer code below.
// The oscilloscope itself gets an independent, time-interpolated visual head.
rdoffs = max(0, srate * 0.05)|0;

// Smooth oscilloscope scrolling without smoothing the waveform amplitudes.
// write_pos jumps by one audio block.  We stay >= 2 blocks behind it, then let
// elapsed wall time continuously reduce that look-back until the next block.
// At the next @block write_pos jumps forward while elapsed resets, so these two
// changes cancel and the visual playhead remains continuous.
osc_visual_delay = max(100, 2 * osc_last_block_samples);
osc_elapsed_samples = (time_precise() - osc_last_block_t) * srate;
osc_elapsed_samples = max(0, min(osc_last_block_samples, osc_elapsed_samples));
osc_rdoffs = max(0, osc_visual_delay - osc_elapsed_samples);

snap_wpos = write_pos - osc_rdoffs;
while(snap_wpos < 0) ( snap_wpos += buffer_size; );
while(snap_wpos >= buffer_size) ( snap_wpos -= buffer_size; );

requested_samples = floor((slider1 / 1000) * srate);
available_samples = max(buffer_valid, 1);
samples_to_draw = min(requested_samples, min(available_samples, buffer_size - 1));
samples_to_draw = max(samples_to_draw, 1);

target_start = snap_wpos - samples_to_draw;
while(target_start < 0) ( target_start += buffer_size; );

active_start_pos = target_start;

// Keep the existing simple zero-crossing retrigger, but do not fade/smooth it.
!is_frozen && slider12 > 0 ? (
  search_ptr = target_start;
  search_limit = min(srate / 10, samples_to_draw);
  found = 0; i = 0;
  while(i < search_limit && !found) (
    p1 = floor(search_ptr);
    p0 = p1 - 1;
    p0 < 0 ? p0 += buffer_size;
    p1 < 0 ? p1 += buffer_size;
    v0 = osc_buffer_start[p0];
    v1 = osc_buffer_start[p1];
    (slider12 == 1 && (v0*v1 < 0)) ||
    (slider12 == 2 && v0 <= 0 && v1 > 0) ||
    (slider12 == 3 && v0 >= 0 && v1 < 0) ? (
      active_start_pos = p1;
      found = 1;
      last_zc_offset = i;
    );
    search_ptr -= 1;
    search_ptr < 0 ? search_ptr += buffer_size;
    i += 1;
  );
  !found ? (
    active_start_pos = target_start - last_zc_offset;
    while(active_start_pos < 0) ( active_start_pos += buffer_size; );
  );
);

active_wpos = active_start_pos + samples_to_draw;
while(active_wpos >= buffer_size) ( active_wpos -= buffer_size; );

// While frozen, only horizontal scrolling is allowed. No animated hold zoom.
drag_mode == 6 ? (
  shift_px = mouse_x - drag_start_x;
  raw_offset = (drag_start_samples - samples_to_draw)/2 + shift_px * (samples_to_draw / max(osc_w,1));
  max_future = snap_wpos - freeze_wpos;
  while(max_future < 0) ( max_future += buffer_size; );
  scroll_offset = min(raw_offset, buffer_size - samples_to_draw);
  scroll_offset = max(-max_future, scroll_offset);
);

render_wpos = is_frozen ? (freeze_wpos - scroll_offset) : active_wpos;
while(render_wpos < 0) ( render_wpos += buffer_size; );
while(render_wpos >= buffer_size) ( render_wpos -= buffer_size; );

viewadv = osc_w / max(samples_to_draw,1); // pixels per sample
draw_ch = (slider2 == 0) ? 1 : (slider2 == 2 ? min(num_ch, max_channels_mem) : 2);
draw_ch = max(1, draw_ch);
chan_size = osc_h / draw_ch;

g_c = 0;
raw_wave_alpha = (slider6 || slider7 || slider8) ? 0.50 : 0.85;
loop(draw_ch,
  center = osc_y + (g_c * chan_size) + (chan_size / 2);
  ch_scale = (chan_size / 2 - (2 * scale)) * (slider13 / 100.0);
  g_buf_start = osc_buffer_start + (g_c * 4 * buffer_size);

  (slider2 == 2 || slider2 == 3) ? (
    gfx_setfont(3);
    gfx_r=0.72; gfx_g=0.72; gfx_b=0.72; gfx_a=0.75;
    gfx_x = osc_x + 6*scale;
    gfx_y = osc_y + g_c*chan_size + 4*scale;
    slider2 == 3 ? (
      g_c == 0 ? gfx_drawstr("MID") : gfx_drawstr("SIDE");
    ) : (
      sprintf(#osc_channel_label,"CH %d",g_c+1);
      gfx_drawstr(#osc_channel_label);
    );
  );

  view_start_pos = render_wpos - samples_to_draw;
  while(view_start_pos < 0) ( view_start_pos += buffer_size; );
  while(view_start_pos >= buffer_size) ( view_start_pos -= buffer_size; );
  rdptr = view_start_pos;

  x = 0;
  viewadv < 1 ? (
    // Multiple samples per pixel: gather min/max for each band, then draw
    // the same simple vertical bars as the Cockos reference.
    lx = 0;
    mino=maxo=g_buf_start[rdptr];
    minl=maxl=(g_buf_start+buffer_size)[rdptr];
    minm=maxm=(g_buf_start+2*buffer_size)[rdptr];
    minh=maxh=(g_buf_start+3*buffer_size)[rdptr];
    (rdptr += 1) >= buffer_size ? rdptr=0;

    loop(samples_to_draw,
      tx = (x|0);
      tx > lx ? (
        minl = min(max(-1,(center+0.5-minl*ch_scale)|0),gfx_h+2);
        maxl = min(max(-1,(center+0.5-maxl*ch_scale)|0),gfx_h+2);
        minm = min(max(-1,(center+0.5-minm*ch_scale)|0),gfx_h+2);
        maxm = min(max(-1,(center+0.5-maxm*ch_scale)|0),gfx_h+2);
        minh = min(max(-1,(center+0.5-minh*ch_scale)|0),gfx_h+2);
        maxh = min(max(-1,(center+0.5-maxh*ch_scale)|0),gfx_h+2);

        // RAW waveform: use the same min/max sample aggregation as the band traces.
        raw_y1 = min(max(osc_y, center - mino*ch_scale), osc_y+osc_h);
        raw_y2 = min(max(osc_y, center - maxo*ch_scale), osc_y+osc_h);
        gfx_r=0.40; gfx_g=0.40; gfx_b=0.40; gfx_a=raw_wave_alpha;
        gfx_line(osc_x+lx, raw_y1, osc_x+lx, raw_y2);

        slider6 ? (
          osc_solo_mix=solo_visual_low; osc_solo_dim=0.30+0.70*osc_solo_mix;
          solo_tint_color(0/255,130/255,200/255,osc_solo_mix,osc_solo_dim);
          gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=osc_solo_dim;
          maxl-1 > center ? gfx_line(osc_x+lx, maxl-1, osc_x+lx, center) : minl+1 < center ? gfx_line(osc_x+lx, minl+1, osc_x+lx, center);
          gfx_a=0.60*osc_solo_dim;
          gfx_line(osc_x+lx,minl,osc_x+lx,maxl);
        );

        slider7 ? (
          osc_solo_mix=solo_visual_mid; osc_solo_dim=0.30+0.70*osc_solo_mix;
          solo_tint_color(190/255,40/255,130/255,osc_solo_mix,osc_solo_dim);
          gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=osc_solo_dim;
          maxm-1 > center ? gfx_line(osc_x+lx, maxm-1, osc_x+lx, center) : minm+1 < center ? gfx_line(osc_x+lx, minm+1, osc_x+lx, center);
          gfx_a=0.60*osc_solo_dim;
          gfx_line(osc_x+lx,minm,osc_x+lx,maxm);
        );

        slider8 ? (
          osc_solo_mix=solo_visual_high; osc_solo_dim=0.30+0.70*osc_solo_mix;
          solo_tint_color(255/255,230/255,50/255,osc_solo_mix,osc_solo_dim);
          gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=osc_solo_dim;
          maxh-1 > center ? gfx_line(osc_x+lx, maxh-1, osc_x+lx, center) : minh+1 < center ? gfx_line(osc_x+lx, minh+1, osc_x+lx, center);
          gfx_a=0.60*osc_solo_dim;
          gfx_line(osc_x+lx,minh,osc_x+lx,maxh);
        );

        // Soloed osc bands are redrawn last: fully opaque, slightly brighter, and in front.
        slider9 && slider6 ? (
          gfx_r=min(1,0/255*1.10+0.02); gfx_g=min(1,130/255*1.10+0.02); gfx_b=min(1,200/255*1.10+0.02); gfx_a=1;
          maxl-1 > center ? gfx_line(osc_x+lx, maxl-1, osc_x+lx, center) : minl+1 < center ? gfx_line(osc_x+lx, minl+1, osc_x+lx, center);
          gfx_line(osc_x+lx,minl,osc_x+lx,maxl);
        );
        slider10 && slider7 ? (
          gfx_r=min(1,190/255*1.10+0.02); gfx_g=min(1,40/255*1.10+0.02); gfx_b=min(1,130/255*1.10+0.02); gfx_a=1;
          maxm-1 > center ? gfx_line(osc_x+lx, maxm-1, osc_x+lx, center) : minm+1 < center ? gfx_line(osc_x+lx, minm+1, osc_x+lx, center);
          gfx_line(osc_x+lx,minm,osc_x+lx,maxm);
        );
        slider11 && slider8 ? (
          gfx_r=min(1,255/255*1.10+0.02); gfx_g=min(1,230/255*1.10+0.02); gfx_b=min(1,50/255*1.10+0.02); gfx_a=1;
          maxh-1 > center ? gfx_line(osc_x+lx, maxh-1, osc_x+lx, center) : minh+1 < center ? gfx_line(osc_x+lx, minh+1, osc_x+lx, center);
          gfx_line(osc_x+lx,minh,osc_x+lx,maxh);
        );

        mino=maxo=g_buf_start[rdptr];
        minl=maxl=(g_buf_start+buffer_size)[rdptr];
        minm=maxm=(g_buf_start+2*buffer_size)[rdptr];
        minh=maxh=(g_buf_start+3*buffer_size)[rdptr];
        lx=tx;
      ) : (
          vo = g_buf_start[rdptr]; mino=min(mino,vo); maxo=max(maxo,vo);
          vl = (g_buf_start+buffer_size)[rdptr]; minl=min(minl,vl); maxl=max(maxl,vl);
          vm = (g_buf_start+2*buffer_size)[rdptr]; minm=min(minm,vm); maxm=max(maxm,vm);
          vh = (g_buf_start+3*buffer_size)[rdptr]; minh=min(minh,vh); maxh=max(maxh,vh);
      );
      rdptr += 1; rdptr >= buffer_size ? rdptr=0;
      x += viewadv;
    );

    // Last pixel.
    minl = min(max(-1,(center+0.5-minl*ch_scale)|0),gfx_h+2);
    maxl = min(max(-1,(center+0.5-maxl*ch_scale)|0),gfx_h+2);
    minm = min(max(-1,(center+0.5-minm*ch_scale)|0),gfx_h+2);
    maxm = min(max(-1,(center+0.5-maxm*ch_scale)|0),gfx_h+2);
    minh = min(max(-1,(center+0.5-minh*ch_scale)|0),gfx_h+2);
    maxh = min(max(-1,(center+0.5-maxh*ch_scale)|0),gfx_h+2);

    // RAW waveform final pixel.
    raw_y1 = min(max(osc_y, center - mino*ch_scale), osc_y+osc_h);
    raw_y2 = min(max(osc_y, center - maxo*ch_scale), osc_y+osc_h);
    gfx_r=0.40; gfx_g=0.40; gfx_b=0.40; gfx_a=raw_wave_alpha;
    gfx_line(osc_x+lx, raw_y1, osc_x+lx, raw_y2);

    slider6 ? (
      osc_solo_mix=solo_visual_low; osc_solo_dim=0.30+0.70*osc_solo_mix;
      solo_tint_color(0/255,130/255,200/255,osc_solo_mix,osc_solo_dim);
      gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=0.9*osc_solo_dim;
      maxl-1 > center ? gfx_line(osc_x+lx,maxl-1,osc_x+lx,center) : minl+1 < center ? gfx_line(osc_x+lx,minl+1,osc_x+lx,center);
      gfx_a=0.60*osc_solo_dim; gfx_line(osc_x+lx,minl,osc_x+lx,maxl);
    );
    slider7 ? (
      osc_solo_mix=solo_visual_mid; osc_solo_dim=0.30+0.70*osc_solo_mix;
      solo_tint_color(190/255,40/255,130/255,osc_solo_mix,osc_solo_dim);
      gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=0.9*osc_solo_dim;
      maxm-1 > center ? gfx_line(osc_x+lx,maxm-1,osc_x+lx,center) : minm+1 < center ? gfx_line(osc_x+lx,minm+1,osc_x+lx,center);
      gfx_a=0.60*osc_solo_dim; gfx_line(osc_x+lx,minm,osc_x+lx,maxm);
    );
    slider8 ? (
      osc_solo_mix=solo_visual_high; osc_solo_dim=0.30+0.70*osc_solo_mix;
      solo_tint_color(255/255,230/255,50/255,osc_solo_mix,osc_solo_dim);
      gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=0.9*osc_solo_dim;
      maxh-1 > center ? gfx_line(osc_x+lx,maxh-1,osc_x+lx,center) : minh+1 < center ? gfx_line(osc_x+lx,minh+1,osc_x+lx,center);
      gfx_a=0.60*osc_solo_dim; gfx_line(osc_x+lx,minh,osc_x+lx,maxh);
    );

    // Final pixel: keep soloed band(s) fully opaque and on top too.
    slider9 && slider6 ? (
      gfx_r=min(1,0/255*1.10+0.02); gfx_g=min(1,130/255*1.10+0.02); gfx_b=min(1,200/255*1.10+0.02); gfx_a=1;
      maxl-1 > center ? gfx_line(osc_x+lx,maxl-1,osc_x+lx,center) : minl+1 < center ? gfx_line(osc_x+lx,minl+1,osc_x+lx,center);
      gfx_line(osc_x+lx,minl,osc_x+lx,maxl);
    );
    slider10 && slider7 ? (
      gfx_r=min(1,190/255*1.10+0.02); gfx_g=min(1,40/255*1.10+0.02); gfx_b=min(1,130/255*1.10+0.02); gfx_a=1;
      maxm-1 > center ? gfx_line(osc_x+lx,maxm-1,osc_x+lx,center) : minm+1 < center ? gfx_line(osc_x+lx,minm+1,osc_x+lx,center);
      gfx_line(osc_x+lx,minm,osc_x+lx,maxm);
    );
    slider11 && slider8 ? (
      gfx_r=min(1,255/255*1.10+0.02); gfx_g=min(1,230/255*1.10+0.02); gfx_b=min(1,50/255*1.10+0.02); gfx_a=1;
      maxh-1 > center ? gfx_line(osc_x+lx,maxh-1,osc_x+lx,center) : minh+1 < center ? gfx_line(osc_x+lx,minh+1,osc_x+lx,center);
      gfx_line(osc_x+lx,minh,osc_x+lx,maxh);
    );
  ) : (
    // Multiple pixels per sample: draw simple filled waveform bars.
    loop(samples_to_draw,
      x1=(x|0);
      x2=((x+=viewadv)|0);
      x2 <= x1 ? x2=x1+1;

      // RAW waveform: neutral grey.
      v = (g_buf_start[rdptr] * ch_scale)|0;
      gfx_r=0.40; gfx_g=0.40; gfx_b=0.40; gfx_a=raw_wave_alpha;
      v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
      gfx_a=0.55; gfx_rect(osc_x+x1,center-v,x2-x1,2);

      slider6 ? (
        osc_solo_mix=solo_visual_low; osc_solo_dim=0.30+0.70*osc_solo_mix;
        solo_tint_color(0/255,130/255,200/255,osc_solo_mix,osc_solo_dim);
        gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=osc_solo_dim;
        v = ((g_buf_start+buffer_size)[rdptr] * ch_scale)|0; // Was missing +buffer_size
        v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
        gfx_a=0.60*osc_solo_dim; gfx_rect(osc_x+x1,center-v,x2-x1,2);
      );

      slider7 ? (
        osc_solo_mix=solo_visual_mid; osc_solo_dim=0.30+0.70*osc_solo_mix;
        solo_tint_color(190/255,40/255,130/255,osc_solo_mix,osc_solo_dim);
        gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=osc_solo_dim;
        v = ((g_buf_start+2*buffer_size)[rdptr] * ch_scale)|0; // Was +buffer_size
        v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
        gfx_a=0.60*osc_solo_dim; gfx_rect(osc_x+x1,center-v,x2-x1,2);
      );

      slider8 ? (
        osc_solo_mix=solo_visual_high; osc_solo_dim=0.30+0.70*osc_solo_mix;
        solo_tint_color(255/255,230/255,50/255,osc_solo_mix,osc_solo_dim);
        gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=osc_solo_dim;
        v = ((g_buf_start+3*buffer_size)[rdptr] * ch_scale)|0; // Was +2*buffer_size
        v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
        gfx_a=0.60*osc_solo_dim; gfx_rect(osc_x+x1,center-v,x2-x1,2);
      );

      // Redraw soloed band(s) last so they are opaque, brighter, and in front.
      slider9 && slider6 ? (
        gfx_r=min(1,0/255*1.10+0.02); gfx_g=min(1,130/255*1.10+0.02); gfx_b=min(1,200/255*1.10+0.02); gfx_a=1;
        v=((g_buf_start+buffer_size)[rdptr]*ch_scale)|0;
        v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
        gfx_rect(osc_x+x1,center-v,x2-x1,2);
      );
      slider10 && slider7 ? (
        gfx_r=min(1,190/255*1.10+0.02); gfx_g=min(1,40/255*1.10+0.02); gfx_b=min(1,130/255*1.10+0.02); gfx_a=1;
        v=((g_buf_start+2*buffer_size)[rdptr]*ch_scale)|0;
        v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
        gfx_rect(osc_x+x1,center-v,x2-x1,2);
      );
      slider11 && slider8 ? (
        gfx_r=min(1,255/255*1.10+0.02); gfx_g=min(1,230/255*1.10+0.02); gfx_b=min(1,50/255*1.10+0.02); gfx_a=1;
        v=((g_buf_start+3*buffer_size)[rdptr]*ch_scale)|0;
        v < 0 ? gfx_rect(osc_x+x1,center,x2-x1,-v) : gfx_rect(osc_x+x1,center-v,x2-x1,v);
        gfx_rect(osc_x+x1,center-v,x2-x1,2);
      );

      rdptr += 1;
      rdptr >= buffer_size ? rdptr=0;
    );
  );
  g_c += 1;
);

drag_mode == 6 ? (
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.35;
  gfx_line(osc_x + osc_w/2, osc_y, osc_x + osc_w/2, osc_y + osc_h);
  gfx_a = 0.75;
  gfx_setfont(3);
  gfx_x = osc_x + osc_w/2 + 5*scale; gfx_y = osc_y + 5*scale;
  gfx_drawstr("SCAN");
);

new_fftidx = slider14|0;
fftidx_changed = new_fftidx != fftidx;

integrate_now = time_precise();
dt = integrate_now - integrate_lastt;
dt > 0.15 ? dt = 0.15;
integrate_sc = 1.0 - exp(-3.0 * dt / (integrate_time * 0.001));
integrate_lastt = integrate_now;

fftidx = min(max(new_fftidx, 0), 3);
fftsize = 2^(fftidx + 10);

fftidx_changed ? (
  i = 0;
  loop(fftsize * 0.5, integrate_buf[i] = 0; peak_buf[i] = -1000; i += 1; );
  i = 0; loop(FFT_STATE_POINTS, peak_buf_l[i] = -120; peak_buf_r[i] = -120; peak_buf_m[i] = -120; i += 1; );
  integrate_sc = 1;
);

windowsize != fftsize ? (
  windowsize = fftsize;
  dwindowpos = 3.14159265 * 2 / fftsize;
  i = pwr = 0;
  loop(fftsize * 0.5 + 1,
    windowpos = i * dwindowpos;
    pwr += (fft_window[i] = 0.35875 - 0.48829 * cos(windowpos) + 0.14128 * cos(2 * windowpos) - 0.01168 * cos(3 * windowpos));
    i += 1;
  );
  pwr = 0.5 / (pwr * 2 - fft_window[i-1]);
  loop(fftsize * 0.5 + 1, fft_window[i-=1] *= pwr; );
);

skip_fft = (drag_mode == 8);
fft_target_pos = floor(fft_write_pos - rdoffs);

// HOLD FFT SYNC:
// The normal FFT ring is intentionally short (~49k samples), while the oscilloscope
// keeps several seconds of history. Mapping an old osc position into the short FFT
// ring makes it wrap and show the wrong moment. During osc Hold/SCAN, build the FFT
// directly from the oscilloscope's long history instead, centered on the scan cursor.
!skip_fft ? (
  drag_mode == 6 ? (
    hold_fft_center = render_wpos - samples_to_draw * 0.5;
    while(hold_fft_center < 0) ( hold_fft_center += buffer_size; );
    while(hold_fft_center >= buffer_size) ( hold_fft_center -= buffer_size; );

    // Prefer a window centered on SCAN. If SCAN is too close to the frozen right
    // edge to provide the future half of the FFT window, shift only as much as needed
    // so we never read unrelated/stale samples beyond the captured region.
    hold_fft_half = fftsize * 0.5;
    hold_future = freeze_wpos - hold_fft_center;
    while(hold_future < 0) ( hold_future += buffer_size; );
    while(hold_future >= buffer_size) ( hold_future -= buffer_size; );
    hold_fft_center_used = hold_fft_center;
    hold_future < hold_fft_half ? hold_fft_center_used -= (hold_fft_half - hold_future);
    while(hold_fft_center_used < 0) ( hold_fft_center_used += buffer_size; );
    while(hold_fft_center_used >= buffer_size) ( hold_fft_center_used -= buffer_size; );

    hold_fft_pos = hold_fft_center_used - hold_fft_half;
    while(hold_fft_pos < 0) ( hold_fft_pos += buffer_size; );
    while(hold_fft_pos >= buffer_size) ( hold_fft_pos -= buffer_size; );

    hold_l_base = osc_buffer_start;
    hold_r_base = osc_buffer_start + 4 * buffer_size;
    hold_solos = slider9 + slider10 + slider11;

    buf3 = fft_workspace;
    buf4 = fft_workspace_r;
    hold_i = 0;
    loop(fftsize,
      hold_idx = floor(hold_fft_pos);
      hold_widx = hold_i <= hold_fft_half ? hold_i : fftsize - hold_i;
      hold_win = fft_window[hold_widx];

      // In M/S osc mode the first two osc channel slots contain Mid and Side.
      // Reconstruct L/R so the FFT keeps the same channel semantics as normal mode.
      slider2 == 3 ? (
        hold_solos > 0 && hold_solos < 3 ? (
          hold_m = 0; hold_s = 0;
          slider9 ? (
            hold_m += (hold_l_base + buffer_size)[hold_idx];
            hold_s += (hold_r_base + buffer_size)[hold_idx];
          );
          slider10 ? (
            hold_m += (hold_l_base + 2*buffer_size)[hold_idx];
            hold_s += (hold_r_base + 2*buffer_size)[hold_idx];
          );
          slider11 ? (
            hold_m += (hold_l_base + 3*buffer_size)[hold_idx];
            hold_s += (hold_r_base + 3*buffer_size)[hold_idx];
          );
        ) : (
          hold_m = hold_l_base[hold_idx];
          hold_s = hold_r_base[hold_idx];
        );
        hold_l = hold_m + hold_s;
        hold_r = hold_m - hold_s;
      ) : (
        hold_solos > 0 && hold_solos < 3 ? (
          hold_l = 0; hold_r = 0;
          slider9 ? (
            hold_l += (hold_l_base + buffer_size)[hold_idx];
            hold_r += max_ch > 1 ? (hold_r_base + buffer_size)[hold_idx] : (hold_l_base + buffer_size)[hold_idx];
          );
          slider10 ? (
            hold_l += (hold_l_base + 2*buffer_size)[hold_idx];
            hold_r += max_ch > 1 ? (hold_r_base + 2*buffer_size)[hold_idx] : (hold_l_base + 2*buffer_size)[hold_idx];
          );
          slider11 ? (
            hold_l += (hold_l_base + 3*buffer_size)[hold_idx];
            hold_r += max_ch > 1 ? (hold_r_base + 3*buffer_size)[hold_idx] : (hold_l_base + 3*buffer_size)[hold_idx];
          );
        ) : (
          hold_l = hold_l_base[hold_idx];
          hold_r = max_ch > 1 ? hold_r_base[hold_idx] : hold_l;
        );
      );

      buf3[] = hold_l * hold_win;
      buf4[] = hold_r * hold_win;
      buf3 += 1;
      buf4 += 1;
      hold_i += 1;
      hold_fft_pos += 1;
      hold_fft_pos >= buffer_size ? hold_fft_pos -= buffer_size;
    );

    fft_real(fft_workspace, fftsize);
    fft_permute(fft_workspace, fftsize/2);
    fft_workspace[1] = 0;
    fft_real(fft_workspace_r, fftsize);
    fft_permute(fft_workspace_r, fftsize/2);
    fft_workspace_r[1] = 0;
    integrate_sc = 1.0;
  ) : (
    // Normal/live FFT path: unchanged short FFT ring.
    snap_fft_pos = fft_target_pos;
    while(snap_fft_pos < 0) ( snap_fft_pos += fft_histsize; );
    while(snap_fft_pos >= fft_histsize) ( snap_fft_pos -= fft_histsize; );

    buf1 = snap_fft_pos - fftsize;
    buf1 < 0 ? buf1 += fft_histsize;

    // --- LEFT FFT ---
    buf2 = fft_window;
    buf3 = fft_workspace;
    loop(fftsize * 0.5 + 1,
      buf3[] = fft_ringbuf_l[buf1] * buf2[];
      buf3 += 1; buf2 += 1; buf1 += 1;
      buf1 >= fft_histsize ? buf1 = 0;
    );
    buf2 -= 1;
    loop(fftsize * 0.5 - 1,
      buf3[] = fft_ringbuf_l[buf1] * (buf2-=1)[];
      buf3 += 1; buf1 += 1;
      buf1 >= fft_histsize ? buf1 = 0;
    );
    fft_real(fft_workspace, fftsize);
    fft_permute(fft_workspace, fftsize/2);
    fft_workspace[1] = 0;

    // --- RIGHT FFT ---
    buf1 = snap_fft_pos - fftsize;
    buf1 < 0 ? buf1 += fft_histsize;
    buf2 = fft_window;
    buf3 = fft_workspace_r;
    loop(fftsize * 0.5 + 1,
      buf3[] = fft_ringbuf_r[buf1] * buf2[];
      buf3 += 1; buf2 += 1; buf1 += 1;
      buf1 >= fft_histsize ? buf1 = 0;
    );
    buf2 -= 1;
    loop(fftsize * 0.5 - 1,
      buf3[] = fft_ringbuf_r[buf1] * (buf2-=1)[];
      buf3 += 1; buf1 += 1;
      buf1 >= fft_histsize ? buf1 = 0;
    );
    fft_real(fft_workspace_r, fftsize);
    fft_permute(fft_workspace_r, fftsize/2);
    fft_workspace_r[1] = 0;
  );

  // --- UNITE integration (exactly the old L+R spectrum) ---
  buf3 = fft_workspace;
  buf4 = fft_workspace_r;
  buf2 = integrate_buf;
  loop(fftsize * 0.5,
    re_sum = buf3[0] + buf4[0];
    im_sum = buf3[1] + buf4[1];
    pwr_val = max(sqr(re_sum) + sqr(im_sum), 10^(-500/10));
    buf3 += 2;
    buf4 += 2;
    drag_mode == 6 ? ( buf2[] = pwr_val; ) : ( buf2[] += integrate_sc * (pwr_val - buf2[]); );
    buf2 += 1;
  );
);

!skip_fft ? update_spatial_tree();

xscale = 800 / (fftsize - 4);

// FFT view colors: purple Mid, neutral grey support, mint L, peach R.
fft_gray_r = 0.58; fft_gray_g = 0.58; fft_gray_b = 0.58;
fft_mid_r = 148/255; fft_mid_g = 174/255; fft_mid_b = 238/255;
fft_mint_r = 0.38; fft_mint_g = 0.96; fft_mint_b = 0.74;
fft_peach_r = 1.00; fft_peach_g = 0.58; fft_peach_b = 0.43;
fft_fill_overlap = 2.5 * scale;

// Exact same fill rasterization mechanism as FFT UNITE.
// Integer x coordinates + tx0 > lx0 gating prevent the vertical seams
// that appeared in the stereo / M-S overlay fills.
function draw_fft_fill_match_unite(lx, ly, tx, ty, base_y, r, g, b, a) local(tx0, lx0) (
  tx0 = tx|0;
  lx0 = lx|0;
  tx0 > lx0 ? (
    gfx_r=r; gfx_g=g; gfx_b=b; gfx_a=a;
    gfx_triangle(lx0, base_y, lx0, ly, tx0-1, ty, tx0-1, base_y);
  );
);

fft_view == 0 ? (
  // FFT UNITE — original single 3-band spectrum.
  buf3 = integrate_buf;
  lx = spec_x; ly = spec_y + fft_plot_h;
  i = 0;
  loop(fftsize * 0.5,
    db = log(max(buf3[], 10^(-500/20*2))) * 10 / 2.30258509;
    db_clamp = max(slider15, min(fft_headroom_db, db));
    ty = fft_db_to_y(db_clamp, slider15, fft_headroom_db, spec_y, fft_plot_h);
    tx_norm = log(1.0 + i*xscale) / fft_log_span;
tx = spec_x + ((tx_norm - fft_zoom_start_draw) / fft_zoom_span_draw) * spec_w;

    curr_f = i * srate / fftsize;
    curr_f < slider4 ? ( gfx_r=0/255; gfx_g=130/255; gfx_b=200/255; ) : 
    curr_f < slider5 ? ( gfx_r=190/255; gfx_g=40/255; gfx_b=130/255; ) : 
                       ( gfx_r=255/255; gfx_g=230/255; gfx_b=50/255; );
    fft_solo_mix=tx<x1_xover ? solo_visual_low : (tx<x2_xover ? solo_visual_mid : solo_visual_high);
    fft_solo_dim=0.62+0.38*fft_solo_mix;
    solo_tint_color(gfx_r,gfx_g,gfx_b,fft_solo_mix,fft_solo_dim);
    gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b;

    slider22 > 0 ? (
      slider22 == 1 && peak_buf[i] > -1000 ? peak_buf[i] = max(-120, peak_buf[i] - peak_decay_db) : 0;
      peak_buf[i] < db ? peak_buf[i] = db : 0;
      db_clamp_peak = max(slider15, min(fft_headroom_db, peak_buf[i]));
      ty_peak = fft_db_to_y(db_clamp_peak, slider15, fft_headroom_db, spec_y, fft_plot_h);
    );

    i ? (
      gfx_a = 0.14*fft_solo_dim;
      tx0 = tx|0; lx0 = lx|0;
      tx0 > lx0 ? gfx_triangle(lx0, spec_y + fft_plot_h, lx0, ly, tx0-1, ty, tx0-1, spec_y + fft_plot_h);
      gfx_a = 0.95*fft_solo_dim; gfx_x = lx; gfx_y = ly; gfx_lineto(tx, ty, 1);
      slider22 > 0 ? (
        solo_tint_color(0.30,0.42,0.37,fft_solo_mix,fft_solo_dim);
        gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=fft_solo_dim;
        gfx_x=lx; gfx_y=ly_peak; gfx_lineto(tx, ty_peak, 1);
      );
    ) : (
      gfx_a=0.95*fft_solo_dim; gfx_x=tx; gfx_y=ty;
    );

    lx=tx; ly=ty;
    slider22 > 0 ? ly_peak=ty_peak;
    buf3 += 1; i += 1;
  );
) : (
  // FFT STEREO / MID-SIDE — L/R FFTs with lightweight temporal smoothing.
  // Pan affects general channel opacity. Peaks keep their channel color at center,
  // while the out-of-pan peak smoothly fades toward neutral grey.
  first_pt = 1;
  prev_x = spec_x;
  prev_y_l = spec_y + fft_plot_h;
  prev_y_r = prev_y_l;
  prev_y_m = prev_y_l;
  prev_py_l = prev_y_l;
  prev_py_r = prev_y_r;
  prev_py_m = prev_y_m;
  curr_pix = -1;
  curr_db_l = -120; curr_db_r = -120; curr_db_m = -120;
  curr_tx = spec_x;

  i=0;
  loop(fftsize * 0.5,
    re_l = fft_workspace[i*2]; im_l = fft_workspace[i*2+1];
    re_r = fft_workspace_r[i*2]; im_r = fft_workspace_r[i*2+1];
    db_l = log(max(sqr(re_l)+sqr(im_l), 10^(-500/10))) * 10 / 2.30258509;
    db_r = log(max(sqr(re_r)+sqr(im_r), 10^(-500/10))) * 10 / 2.30258509;

    // True M/S decomposition for the dedicated MID-SIDE view.
    // SIDE L = (L-R)/2, SIDE R = (R-L)/2, MID = (L+R)/2.
    re_sl = (re_l - re_r) * 0.5; im_sl = (im_l - im_r) * 0.5;
    re_sr = (re_r - re_l) * 0.5; im_sr = (im_r - im_l) * 0.5;
    db_sl = log(max(sqr(re_sl)+sqr(im_sl), 10^(-500/10))) * 10 / 2.30258509;
    db_sr = log(max(sqr(re_sr)+sqr(im_sr), 10^(-500/10))) * 10 / 2.30258509;

    re_m = (re_l + re_r) * 0.5; im_m = (im_l + im_r) * 0.5;
    db_m = log(max(sqr(re_m)+sqr(im_m), 10^(-500/10))) * 10 / 2.30258509;
    fft_view == 2 ? ( db_l = db_sl; db_r = db_sr; );

    tx_norm = log(1.0 + i*xscale) / fft_log_span;
tx = spec_x + ((tx_norm - fft_zoom_start_draw) / fft_zoom_span_draw) * spec_w;
    // Peak/smoothing state is tied to the ORIGINAL full-spectrum frequency
    // coordinate, not the zoomed screen coordinate. This keeps peak holds
    // locked to frequency when the FFT scrollbar zoom/pans the display.
    pix = floor(tx_norm * (FFT_STATE_POINTS-1));
    pix = max(0, min(FFT_STATE_POINTS-1, pix));

    curr_pix >= 0 && pix != curr_pix ? (
      sm_l = fft_prev_l[curr_pix] + integrate_sc * (curr_db_l - fft_prev_l[curr_pix]);
      sm_r = fft_prev_r[curr_pix] + integrate_sc * (curr_db_r - fft_prev_r[curr_pix]);
      sm_m = fft_prev_m[curr_pix] + integrate_sc * (curr_db_m - fft_prev_m[curr_pix]);
      fft_prev_l[curr_pix]=sm_l; fft_prev_r[curr_pix]=sm_r; fft_prev_m[curr_pix]=sm_m;

      draw_x = curr_tx;
      y_l = fft_db_to_y(sm_l, slider15, fft_headroom_db, spec_y, fft_plot_h);
      y_r = fft_db_to_y(sm_r, slider15, fft_headroom_db, spec_y, fft_plot_h);
      y_m = fft_db_to_y(sm_m, slider15, fft_headroom_db, spec_y, fft_plot_h);
      fft_solo_mix=draw_x<x1_xover ? solo_visual_low : (draw_x<x2_xover ? solo_visual_mid : solo_visual_high);
      fft_solo_dim=0.62+0.38*fft_solo_mix;

      // --- Channel opacity/pan ---
      fft_view == 1 ? (
        l_gain = 1 - max(0, fft_pan_display);
        r_gain = 1 + min(0, fft_pan_display);

        // Curve colors: fully channel-colored at center, drifting to grey when panned out.
        c_l_r=fft_gray_r*(1-l_gain)+fft_mint_r*l_gain; c_l_g=fft_gray_g*(1-l_gain)+fft_mint_g*l_gain; c_l_b=fft_gray_b*(1-l_gain)+fft_mint_b*l_gain;
        c_r_r=fft_gray_r*(1-r_gain)+fft_peach_r*r_gain; c_r_g=fft_gray_g*(1-r_gain)+fft_peach_g*r_gain; c_r_b=fft_gray_b*(1-r_gain)+fft_peach_b*r_gain;
        solo_tint_color(c_l_r,c_l_g,c_l_b,fft_solo_mix,fft_solo_dim); c_l_r=shade_r; c_l_g=shade_g; c_l_b=shade_b;
        solo_tint_color(c_r_r,c_r_g,c_r_b,fft_solo_mix,fft_solo_dim); c_r_r=shade_r; c_r_g=shade_g; c_r_b=shade_b;

        line_a_l=(0.10+0.70*l_gain)*fft_solo_dim;
        line_a_r=(0.10+0.70*r_gain)*fft_solo_dim;
        fill_a_l=0.065*l_gain*fft_solo_dim;
        fill_a_r=0.065*r_gain*fft_solo_dim;

        !first_pt ? (
          // Filled spectra.
          fill_a_l > 0 ? draw_fft_fill_match_unite(prev_x, prev_y_l, draw_x, y_l, spec_y + fft_plot_h, c_l_r, c_l_g, c_l_b, fill_a_l);
          fill_a_r > 0 ? draw_fft_fill_match_unite(prev_x, prev_y_r, draw_x, y_r, spec_y + fft_plot_h, c_r_r, c_r_g, c_r_b, fill_a_r);

          // Main peaks/curves.
          gfx_r=c_l_r; gfx_g=c_l_g; gfx_b=c_l_b; gfx_a=line_a_l; gfx_x=prev_x; gfx_y=prev_y_l; gfx_lineto(draw_x,y_l,1);
          gfx_r=c_r_r; gfx_g=c_r_g; gfx_b=c_r_b; gfx_a=line_a_r; gfx_x=prev_x; gfx_y=prev_y_r; gfx_lineto(draw_x,y_r,1);
        ) : first_pt=0;
      ) : (
        // MID-SIDE: L/R remain separate side components, with grey Mid overlay.
        mid_gain = 1 - max(0, fft_pan_display);
        side_gain = 1 + min(0, fft_pan_display);

        l_side_r=fft_gray_r*(1-side_gain)+fft_mint_r*side_gain; l_side_g=fft_gray_g*(1-side_gain)+fft_mint_g*side_gain; l_side_b=fft_gray_b*(1-side_gain)+fft_mint_b*side_gain;
        r_side_r=fft_gray_r*(1-side_gain)+fft_peach_r*side_gain; r_side_g=fft_gray_g*(1-side_gain)+fft_peach_g*side_gain; r_side_b=fft_gray_b*(1-side_gain)+fft_peach_b*side_gain;
        solo_tint_color(l_side_r,l_side_g,l_side_b,fft_solo_mix,fft_solo_dim); l_side_r=shade_r; l_side_g=shade_g; l_side_b=shade_b;
        solo_tint_color(r_side_r,r_side_g,r_side_b,fft_solo_mix,fft_solo_dim); r_side_r=shade_r; r_side_g=shade_g; r_side_b=shade_b;

        side_line_a=(0.10+0.70*side_gain)*fft_solo_dim;
        mid_line_a=(0.10+0.70*mid_gain)*fft_solo_dim;
        side_fill_a=0.045*side_gain*fft_solo_dim;
        mid_fill_a=0.040*mid_gain*fft_solo_dim;

        !first_pt ? (
          // Side fills + Mid fill.
          side_fill_a > 0 ? (
            draw_fft_fill_match_unite(prev_x, prev_y_l, draw_x, y_l, spec_y + fft_plot_h, l_side_r, l_side_g, l_side_b, side_fill_a);
            draw_fft_fill_match_unite(prev_x, prev_y_r, draw_x, y_r, spec_y + fft_plot_h, r_side_r, r_side_g, r_side_b, side_fill_a);
          );
          solo_tint_color(fft_mid_r,fft_mid_g,fft_mid_b,fft_solo_mix,fft_solo_dim);
          mid_fill_a > 0 ? draw_fft_fill_match_unite(prev_x, prev_y_m, draw_x, y_m, spec_y + fft_plot_h, shade_r, shade_g, shade_b, mid_fill_a);

          // Main curves.
          gfx_r=l_side_r; gfx_g=l_side_g; gfx_b=l_side_b; gfx_a=side_line_a; gfx_x=prev_x; gfx_y=prev_y_l; gfx_lineto(draw_x,y_l,1);
          gfx_r=r_side_r; gfx_g=r_side_g; gfx_b=r_side_b; gfx_a=side_line_a; gfx_x=prev_x; gfx_y=prev_y_r; gfx_lineto(draw_x,y_r,1);
          gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=mid_line_a; gfx_x=prev_x; gfx_y=prev_y_m; gfx_lineto(draw_x,y_m,1);
        ) : first_pt=0;
      );

      // Peak hold curves.
      slider22 > 0 ? (
        slider22 == 1 ? (
          peak_buf_l[curr_pix] = max(-120, peak_buf_l[curr_pix] - peak_decay_db);
          peak_buf_r[curr_pix] = max(-120, peak_buf_r[curr_pix] - peak_decay_db);
          peak_buf_m[curr_pix] = max(-120, peak_buf_m[curr_pix] - peak_decay_db);
        );
        peak_buf_l[curr_pix] < sm_l ? peak_buf_l[curr_pix] = sm_l : 0;
        peak_buf_r[curr_pix] < sm_r ? peak_buf_r[curr_pix] = sm_r : 0;
        peak_buf_m[curr_pix] < sm_m ? peak_buf_m[curr_pix] = sm_m : 0;

        p_l = max(slider15,min(0,peak_buf_l[curr_pix]));
        p_r = max(slider15,min(0,peak_buf_r[curr_pix]));
        p_m = max(slider15,min(0,peak_buf_m[curr_pix]));
        py_l = fft_db_to_y(p_l, slider15, fft_headroom_db, spec_y, fft_plot_h);
        py_r = fft_db_to_y(p_r, slider15, fft_headroom_db, spec_y, fft_plot_h);
        py_m = fft_db_to_y(p_m, slider15, fft_headroom_db, spec_y, fft_plot_h);

        fft_view == 1 ? (
          l_gain = 1 - max(0, fft_pan_display);
          r_gain = 1 + min(0, fft_pan_display);
          c_l_r=fft_gray_r*(1-l_gain)+fft_mint_r*l_gain; c_l_g=fft_gray_g*(1-l_gain)+fft_mint_g*l_gain; c_l_b=fft_gray_b*(1-l_gain)+fft_mint_b*l_gain;
          c_r_r=fft_gray_r*(1-r_gain)+fft_peach_r*r_gain; c_r_g=fft_gray_g*(1-r_gain)+fft_peach_g*r_gain; c_r_b=fft_gray_b*(1-r_gain)+fft_peach_b*r_gain;
          solo_tint_color(c_l_r,c_l_g,c_l_b,fft_solo_mix,fft_solo_dim); c_l_r=shade_r; c_l_g=shade_g; c_l_b=shade_b;
          solo_tint_color(c_r_r,c_r_g,c_r_b,fft_solo_mix,fft_solo_dim); c_r_r=shade_r; c_r_g=shade_g; c_r_b=shade_b;
          peak_alpha_l = (0.18 + 0.82*l_gain)*fft_solo_dim;
          peak_alpha_r = (0.18 + 0.82*r_gain)*fft_solo_dim;
          solo_tint_color(0.30,0.58,0.45,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_l; gfx_x=prev_x; gfx_y=prev_py_l; gfx_lineto(draw_x,py_l,1);
          solo_tint_color(0.62,0.36,0.30,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_r; gfx_x=prev_x; gfx_y=prev_py_r; gfx_lineto(draw_x,py_r,1);
        ) : (
          mid_gain = 1 - max(0, fft_pan_display);
          side_gain = 1 + min(0, fft_pan_display);
          l_side_r=fft_gray_r*(1-side_gain)+fft_mint_r*side_gain; l_side_g=fft_gray_g*(1-side_gain)+fft_mint_g*side_gain; l_side_b=fft_gray_b*(1-side_gain)+fft_mint_b*side_gain;
          r_side_r=fft_gray_r*(1-side_gain)+fft_peach_r*side_gain; r_side_g=fft_gray_g*(1-side_gain)+fft_peach_g*side_gain; r_side_b=fft_gray_b*(1-side_gain)+fft_peach_b*side_gain;
          solo_tint_color(l_side_r,l_side_g,l_side_b,fft_solo_mix,fft_solo_dim); l_side_r=shade_r; l_side_g=shade_g; l_side_b=shade_b;
          solo_tint_color(r_side_r,r_side_g,r_side_b,fft_solo_mix,fft_solo_dim); r_side_r=shade_r; r_side_g=shade_g; r_side_b=shade_b;
          peak_alpha_l = (0.18 + 0.82*side_gain)*fft_solo_dim;
          peak_alpha_r = (0.18 + 0.82*side_gain)*fft_solo_dim;
          peak_alpha_m = (0.18 + 0.82*mid_gain)*fft_solo_dim;
          solo_tint_color(0.30,0.58,0.45,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_l; gfx_x=prev_x; gfx_y=prev_py_l; gfx_lineto(draw_x,py_l,1);
          solo_tint_color(0.62,0.36,0.30,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_r; gfx_x=prev_x; gfx_y=prev_py_r; gfx_lineto(draw_x,py_r,1);
          solo_tint_color(fft_mid_r*0.72,fft_mid_g*0.72,fft_mid_b*0.72,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_m; gfx_x=prev_x; gfx_y=prev_py_m; gfx_lineto(draw_x,py_m,1);
        );
      );

      prev_x=draw_x; prev_y_l=y_l; prev_y_r=y_r; prev_y_m=y_m;
      slider22 > 0 ? (prev_py_l=py_l; prev_py_r=py_r; prev_py_m=py_m;) : (prev_py_l=y_l; prev_py_r=y_r; prev_py_m=y_m;);
      curr_pix=pix; curr_db_l=db_l; curr_db_r=db_r; curr_db_m=db_m; curr_tx=tx;
    ) : (
      curr_pix < 0 ? (
        curr_pix=pix; curr_db_l=db_l; curr_db_r=db_r; curr_db_m=db_m; curr_tx=tx;
      ) : (
        db_l>curr_db_l ? curr_db_l=db_l;
        db_r>curr_db_r ? curr_db_r=db_r;
        db_m>curr_db_m ? curr_db_m=db_m;
        curr_tx=tx;
      );
    );
    i+=1;
  );

  curr_pix>=0 ? (
    sm_l=fft_prev_l[curr_pix]+integrate_sc*(curr_db_l-fft_prev_l[curr_pix]);
    sm_r=fft_prev_r[curr_pix]+integrate_sc*(curr_db_r-fft_prev_r[curr_pix]);
    sm_m=fft_prev_m[curr_pix]+integrate_sc*(curr_db_m-fft_prev_m[curr_pix]);
    fft_prev_l[curr_pix]=sm_l; fft_prev_r[curr_pix]=sm_r; fft_prev_m[curr_pix]=sm_m;
    draw_x=curr_tx;
    y_l=fft_db_to_y(sm_l, slider15, fft_headroom_db, spec_y, fft_plot_h);
    y_r=fft_db_to_y(sm_r, slider15, fft_headroom_db, spec_y, fft_plot_h);
    y_m=fft_db_to_y(sm_m, slider15, fft_headroom_db, spec_y, fft_plot_h);
    fft_solo_mix=draw_x<x1_xover ? solo_visual_low : (draw_x<x2_xover ? solo_visual_mid : solo_visual_high);
    fft_solo_dim=0.62+0.38*fft_solo_mix;

    fft_view==1 ? (
      l_gain=1-max(0,fft_pan_display); r_gain=1+min(0,fft_pan_display);
      c_l_r=fft_gray_r*(1-l_gain)+fft_mint_r*l_gain; c_l_g=fft_gray_g*(1-l_gain)+fft_mint_g*l_gain; c_l_b=fft_gray_b*(1-l_gain)+fft_mint_b*l_gain;
      c_r_r=fft_gray_r*(1-r_gain)+fft_peach_r*r_gain; c_r_g=fft_gray_g*(1-r_gain)+fft_peach_g*r_gain; c_r_b=fft_gray_b*(1-r_gain)+fft_peach_b*r_gain;
      solo_tint_color(c_l_r,c_l_g,c_l_b,fft_solo_mix,fft_solo_dim); c_l_r=shade_r; c_l_g=shade_g; c_l_b=shade_b;
      solo_tint_color(c_r_r,c_r_g,c_r_b,fft_solo_mix,fft_solo_dim); c_r_r=shade_r; c_r_g=shade_g; c_r_b=shade_b;
      !first_pt ? (
        fill_a_l=0.065*l_gain*fft_solo_dim; fill_a_r=0.065*r_gain*fft_solo_dim;
        fill_a_l>0 ? draw_fft_fill_match_unite(prev_x, prev_y_l, draw_x, y_l, spec_y + fft_plot_h, c_l_r, c_l_g, c_l_b, fill_a_l);
        fill_a_r>0 ? draw_fft_fill_match_unite(prev_x, prev_y_r, draw_x, y_r, spec_y + fft_plot_h, c_r_r, c_r_g, c_r_b, fill_a_r);
        gfx_r=c_l_r; gfx_g=c_l_g; gfx_b=c_l_b; gfx_a=(0.06+0.38*l_gain)*fft_solo_dim; gfx_x=prev_x; gfx_y=prev_y_l; gfx_lineto(draw_x,y_l,1);
        gfx_r=c_r_r; gfx_g=c_r_g; gfx_b=c_r_b; gfx_a=(0.06+0.38*r_gain)*fft_solo_dim; gfx_x=prev_x; gfx_y=prev_y_r; gfx_lineto(draw_x,y_r,1);
      );
    ) : (
      mid_gain=1-max(0,fft_pan_display); side_gain=1+min(0,fft_pan_display);
      l_side_r=fft_gray_r*(1-side_gain)+fft_mint_r*side_gain; l_side_g=fft_gray_g*(1-side_gain)+fft_mint_g*side_gain; l_side_b=fft_gray_b*(1-side_gain)+fft_mint_b*side_gain;
      r_side_r=fft_gray_r*(1-side_gain)+fft_peach_r*side_gain; r_side_g=fft_gray_g*(1-side_gain)+fft_peach_g*side_gain; r_side_b=fft_gray_b*(1-side_gain)+fft_peach_b*side_gain;
      solo_tint_color(l_side_r,l_side_g,l_side_b,fft_solo_mix,fft_solo_dim); l_side_r=shade_r; l_side_g=shade_g; l_side_b=shade_b;
      solo_tint_color(r_side_r,r_side_g,r_side_b,fft_solo_mix,fft_solo_dim); r_side_r=shade_r; r_side_g=shade_g; r_side_b=shade_b;
      !first_pt ? (
        side_fill_a=0.045*side_gain*fft_solo_dim; mid_fill_a=0.040*mid_gain*fft_solo_dim;
        side_fill_a>0 ? (
          draw_fft_fill_match_unite(prev_x, prev_y_l, draw_x, y_l, spec_y + fft_plot_h, l_side_r, l_side_g, l_side_b, side_fill_a);
          draw_fft_fill_match_unite(prev_x, prev_y_r, draw_x, y_r, spec_y + fft_plot_h, r_side_r, r_side_g, r_side_b, side_fill_a);
        );
        solo_tint_color(fft_mid_r,fft_mid_g,fft_mid_b,fft_solo_mix,fft_solo_dim);
        mid_fill_a>0 ? draw_fft_fill_match_unite(prev_x, prev_y_m, draw_x, y_m, spec_y + fft_plot_h, shade_r, shade_g, shade_b, mid_fill_a);
        gfx_r=l_side_r; gfx_g=l_side_g; gfx_b=l_side_b; gfx_a=(0.06+0.38*side_gain)*fft_solo_dim; gfx_x=prev_x; gfx_y=prev_y_l; gfx_lineto(draw_x,y_l,1);
        gfx_r=r_side_r; gfx_g=r_side_g; gfx_b=r_side_b; gfx_a=(0.06+0.38*side_gain)*fft_solo_dim; gfx_x=prev_x; gfx_y=prev_y_r; gfx_lineto(draw_x,y_r,1);
        solo_tint_color(fft_mid_r,fft_mid_g,fft_mid_b,fft_solo_mix,fft_solo_dim);
        gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=(0.06+0.38*mid_gain)*fft_solo_dim; gfx_x=prev_x; gfx_y=prev_y_m; gfx_lineto(draw_x,y_m,1);
      );
    );

    slider22 > 0 ? (
      peak_buf_l[curr_pix] < sm_l ? peak_buf_l[curr_pix]=sm_l : 0;
      peak_buf_r[curr_pix] < sm_r ? peak_buf_r[curr_pix]=sm_r : 0;
      peak_buf_m[curr_pix] < sm_m ? peak_buf_m[curr_pix]=sm_m : 0;
      py_l=fft_db_to_y(peak_buf_l[curr_pix], slider15, fft_headroom_db, spec_y, fft_plot_h);
      py_r=fft_db_to_y(peak_buf_r[curr_pix], slider15, fft_headroom_db, spec_y, fft_plot_h);
      py_m=fft_db_to_y(peak_buf_m[curr_pix], slider15, fft_headroom_db, spec_y, fft_plot_h);
      fft_view==1 ? (
        l_gain=1-max(0,fft_pan_display); r_gain=1+min(0,fft_pan_display);
        c_l_r=fft_gray_r*(1-l_gain)+fft_mint_r*l_gain; c_l_g=fft_gray_g*(1-l_gain)+fft_mint_g*l_gain; c_l_b=fft_gray_b*(1-l_gain)+fft_mint_b*l_gain;
        c_r_r=fft_gray_r*(1-r_gain)+fft_peach_r*r_gain; c_r_g=fft_gray_g*(1-r_gain)+fft_peach_g*r_gain; c_r_b=fft_gray_b*(1-r_gain)+fft_peach_b*r_gain;
        solo_tint_color(c_l_r,c_l_g,c_l_b,fft_solo_mix,fft_solo_dim); c_l_r=shade_r; c_l_g=shade_g; c_l_b=shade_b;
        solo_tint_color(c_r_r,c_r_g,c_r_b,fft_solo_mix,fft_solo_dim); c_r_r=shade_r; c_r_g=shade_g; c_r_b=shade_b;
        peak_alpha_l = (0.18 + 0.82*l_gain)*fft_solo_dim;
        peak_alpha_r = (0.18 + 0.82*r_gain)*fft_solo_dim;
        solo_tint_color(0.30,0.58,0.45,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_l; gfx_x=prev_x; gfx_y=prev_py_l; gfx_lineto(draw_x,py_l,1);
        solo_tint_color(0.62,0.36,0.30,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_r; gfx_x=prev_x; gfx_y=prev_py_r; gfx_lineto(draw_x,py_r,1);
      ) : (
        mid_gain=1-max(0,fft_pan_display); side_gain=1+min(0,fft_pan_display);
        l_side_r=fft_gray_r*(1-side_gain)+fft_mint_r*side_gain; l_side_g=fft_gray_g*(1-side_gain)+fft_mint_g*side_gain; l_side_b=fft_gray_b*(1-side_gain)+fft_mint_b*side_gain;
        r_side_r=fft_gray_r*(1-side_gain)+fft_peach_r*side_gain; r_side_g=fft_gray_g*(1-side_gain)+fft_peach_g*side_gain; r_side_b=fft_gray_b*(1-side_gain)+fft_peach_b*side_gain;
        solo_tint_color(l_side_r,l_side_g,l_side_b,fft_solo_mix,fft_solo_dim); l_side_r=shade_r; l_side_g=shade_g; l_side_b=shade_b;
        solo_tint_color(r_side_r,r_side_g,r_side_b,fft_solo_mix,fft_solo_dim); r_side_r=shade_r; r_side_g=shade_g; r_side_b=shade_b;
        peak_alpha_l = (0.18 + 0.82*side_gain)*fft_solo_dim;
        peak_alpha_r = (0.18 + 0.82*side_gain)*fft_solo_dim;
        peak_alpha_m = (0.18 + 0.82*mid_gain)*fft_solo_dim;
        solo_tint_color(0.30,0.58,0.45,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_l; gfx_x=prev_x; gfx_y=prev_py_l; gfx_lineto(draw_x,py_l,1);
        solo_tint_color(0.62,0.36,0.30,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_r; gfx_x=prev_x; gfx_y=prev_py_r; gfx_lineto(draw_x,py_r,1);
        solo_tint_color(fft_mid_r*0.72,fft_mid_g*0.72,fft_mid_b*0.72,fft_solo_mix,fft_solo_dim); gfx_r=shade_r; gfx_g=shade_g; gfx_b=shade_b; gfx_a=peak_alpha_m; gfx_x=prev_x; gfx_y=prev_py_m; gfx_lineto(draw_x,py_m,1);
      );
    );
  );
);

(mouse_y >= spec_y && mouse_y <= spec_y + fft_plot_h && mouse_x >= spec_x && mouse_x <= spec_x + spec_w) ? (
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.8;
  gfx_line(mouse_x - 6*scale, mouse_y, mouse_x + 6*scale, mouse_y);
  gfx_line(mouse_x, mouse_y - 6*scale, mouse_x, mouse_y + 6*scale);
  
  cross_norm = fft_zoom_start_draw + ((mouse_x - spec_x) / max(spec_w,1)) * fft_zoom_span_draw;
cross_norm = max(0, min(1, cross_norm));
cross_f = (exp(cross_norm * fft_log_span) - 1.0) / 400.0 * srate / 2.0;
  cross_db = fft_headroom_db - (mouse_y - spec_y) / fft_plot_h * (fft_headroom_db - slider15);
  
  cross_f >= 1000 ? sprintf(#cross_str, "%.1f kHz | %.1f dB", cross_f/1000, cross_db) : sprintf(#cross_str, "%.0f Hz | %.1f dB", cross_f, cross_db);
  
  gfx_setfont(3);
  gfx_measurestr(#cross_str, cw, ch);
  
  cx = mouse_x - cw - 12*scale;
  cy = mouse_y - ch - 12*scale;
  
  cx < spec_x + 4*scale ? cx = mouse_x + 12*scale;
  cy < spec_y + 4*scale ? cy = mouse_y + 12*scale;
  
  gfx_r = 20/255; gfx_g = 20/255; gfx_b = 20/255; gfx_a = 0.85;
  gfx_rect(cx - 4*scale, cy - 2*scale, cw + 8*scale, ch + 4*scale);
  
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 1.0;
  gfx_x = cx; gfx_y = cy;
  gfx_drawstr(#cross_str);
);

is_embedded ? (
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.08;
  gfx_line(osc_w, 0, osc_w, gfx_h);
);

sidebar_enabled ? (
  gfx_r=0.035; gfx_g=0.035; gfx_b=0.035; gfx_a=1;
  gfx_rect(gx, side_top, gw, side_bot - side_top);
  gfx_r=0.16; gfx_g=0.16; gfx_b=0.16; gfx_a=1;
  gfx_line(gx, side_top, gx, side_bot);

  draw_goniometer_bg(gx+4*scale, gonio_start_y, gw-8*scale, gh, 1-tree_mode_display);
  snap_goni_pos = floor(goni_pos - rdoffs);
  while(snap_goni_pos < 0) ( snap_goni_pos += goni_size; );
  while(snap_goni_pos >= goni_size) ( snap_goni_pos -= goni_size; );

  slider16 ? draw_goniometer_layer(gx+4*scale, gonio_start_y, gw-8*scale, gh, goni_base+goni_size*6, 0.2, 0.2, 0.2, snap_goni_pos, goni_zoom_display, slider32, 1-tree_mode_display);
  slider17 ? draw_goniometer_layer(gx+4*scale, gonio_start_y, gw-8*scale, gh, goni_base, 0/255, 130/255, 200/255, snap_goni_pos, goni_zoom_display, slider32, 1-tree_mode_display);
  slider18 ? draw_goniometer_layer(gx+4*scale, gonio_start_y, gw-8*scale, gh, goni_base+goni_size*2, 190/255, 40/255, 130/255, snap_goni_pos, goni_zoom_display, slider32, 1-tree_mode_display);
  slider19 ? draw_goniometer_layer(gx+4*scale, gonio_start_y, gw-8*scale, gh, goni_base+goni_size*4, 255/255, 230/255, 50/255, snap_goni_pos, goni_zoom_display, slider32, 1-tree_mode_display);

  tree_mode_display > 0.001 ? draw_spatial_tree(tree_plot_x, tree_plot_top, tree_plot_w, tree_plot_h, tree_mode_display);

  tree_mode_display < 0.5 ? (
    gfx_setfont(3);
    draw_btn(gonio_btn_x, gonio_btn_y, gonio_btn_w-2*scale, 16*scale, "RAW", slider16, 0.5, 0.7, 0.7, 2*scale, 0.25);
    draw_btn(gonio_btn_x+gonio_btn_w, gonio_btn_y, gonio_btn_w-2*scale, 16*scale, "LOW", slider17, 50/255, 130/255, 200/255, 2*scale, 0.25);
    draw_btn(gonio_btn_x+gonio_btn_w*2, gonio_btn_y, gonio_btn_w-2*scale, 16*scale, "MID", slider18, 190/255, 40/255, 130/255, 2*scale, 0.25);
    draw_btn(gonio_btn_x+gonio_btn_w*3, gonio_btn_y, gonio_btn_w-2*scale, 16*scale, "HI", slider19, 255/255, 230/255, 50/255, 2*scale, 0.25);
    !sidebar_compact ? (
      gfx_setfont(5);
      sprintf(#gzoom_str, "ZOOM %d%%", goni_zoom_display|0);
      gfx_measurestr(#gzoom_str, tw, th);
      gfx_r=0.38; gfx_g=0.38; gfx_b=0.38; gfx_a=1;
      gfx_x = bx_gzoom_x + zoom_w*0.5 - tw*0.5;
      gfx_y = bx_gzoom_y + (tbh-th)*0.5;
      gfx_drawstr(#gzoom_str);
      gfx_setfont(1);
    );
  );

  tree_mode_display < 0.999 ? (
    ms_w = gw - 14*scale;
    ms_x = gx + 7*scale;
    sidebar_compact ? (
      draw_complex_meter(ms_x, ms_start_y + 10*scale, ms_w, 15*scale, "MID", "", 0, env_db_m_raw, env_db_m_l, env_db_m_m, env_db_m_h, 0, 1-tree_mode_display);
      draw_complex_meter(ms_x, ms_start_y + 40*scale, ms_w, 15*scale, "SIDE", "", 0, env_db_s_raw, env_db_s_l, env_db_s_m, env_db_s_h, 0, 1-tree_mode_display);
    ) : (
      draw_complex_meter(ms_x, ms_start_y + 10*scale, ms_w, 15*scale, "MID", "", 0, env_db_m_raw, env_db_m_l, env_db_m_m, env_db_m_h, 1, 1-tree_mode_display);
      draw_complex_meter(ms_x, ms_start_y + 40*scale, ms_w, 15*scale, "SIDE", "", 0, env_db_s_raw, env_db_s_l, env_db_s_m, env_db_s_h, 1, 1-tree_mode_display);
    );
  );

  tree_splitter_active ? (
    // A column-wide separator with two centered grip strokes, one above and
    // one below the line. Meter values have their own reserved row beneath it.
    gfx_r=0.42; gfx_g=0.42; gfx_b=0.42; gfx_a=0.92;
    gfx_rect(gx+1*scale, tree_splitter_y+tree_splitter_h*0.5-0.5*scale, gw-2*scale, 1*scale);
    gfx_r=0.58; gfx_g=0.58; gfx_b=0.58; gfx_a=0.95;
    gfx_rect(gx+gw*0.5-12*scale, tree_splitter_y+tree_splitter_h*0.5-6*scale, 24*scale, 2*scale);
    gfx_rect(gx+gw*0.5-12*scale, tree_splitter_y+tree_splitter_h*0.5+4*scale, 24*scale, 2*scale);
  );
  slider29 >= 0.5 ? sprintf(#tree_toggle_label, "TREE") : sprintf(#tree_toggle_label, "GONIO");
  draw_btn(tree_toggle_x, tree_toggle_y, tree_toggle_w, tree_toggle_h, #tree_toggle_label, slider29 >= 0.5, 0.20, 0.76, 0.69, 3*scale, 0.25);
  slider29 >= 0.5 ? (
    slider31 < 0.5 ? (sprintf(#style_toggle_label,"STRIPS"); style_label_r=0.96; style_label_g=0.31; style_label_b=0.62;) :
    slider31 < 1.5 ? (sprintf(#style_toggle_label,"DUST"); style_label_r=0.24; style_label_g=0.62; style_label_b=1.0;) :
    (sprintf(#style_toggle_label,"LINES"); style_label_r=1.0; style_label_g=0.68; style_label_b=0.43;);
  ) : (
    slider32 >= 0.5 ? (sprintf(#style_toggle_label,"DUST"); style_label_r=0.24; style_label_g=0.62; style_label_b=1.0;) :
    (sprintf(#style_toggle_label,"LASSO"); style_label_r=0.70; style_label_g=0.70; style_label_b=0.70;);
  );
  style_toggle_active=1;
  draw_btn(style_toggle_x,style_toggle_y,style_toggle_w,tree_toggle_h,#style_toggle_label,style_toggle_active,style_label_r,style_label_g,style_label_b,3*scale,0.25);

  meter_x=gx+7*scale; meter_w=gw-14*scale;
  my=meters_start_y;
  lufs_m=pow_val > 0.000000001 ? (10.0*log10(l_power_mm)-0.691) : -144;
  lufs_s=l_power_st > 0.000000001 ? (10.0*log10(l_power_st)-0.691) : -144;
  lufs_l=l_power_lt > 0.000000001 ? (10.0*log10(l_power_lt)-0.691) : -144;
  rms_all_db=rms_all_p>0.000000000001 ? 10*log10(rms_all_p) : -120;
  rms_low_db=rms_low_p>0.000000000001 ? 10*log10(rms_low_p) : -120;
  rms_mid_db=rms_mid_p>0.000000000001 ? 10*log10(rms_mid_p) : -120;
  rms_high_db=rms_high_p>0.000000000001 ? 10*log10(rms_high_p) : -120;

  sidebar_compact ? (
    vx = gx + 4*scale;
    draw_vertical_3stripe_stereo_meter(vx, meters_start_y, meter_col_w, meter_h, "TP", tp_db_state_l, tp_db_state_r, tp_hold_l, tp_hold_r, -60, 6, tp_clip);
    vx += meter_col_w + meter_col_gap;
    draw_vertical_meter(vx, meters_start_y, meter_col_w, meter_h, "M", lufs_m, -60, 0, 0/255,230/255,160/255);
    vx += meter_col_w + meter_col_gap;
    draw_vertical_meter(vx, meters_start_y, meter_col_w, meter_h, "S", lufs_s, -60, 0, 0/255,190/255,150/255);
    vx += meter_col_w + meter_col_gap;
    draw_vertical_meter(vx, meters_start_y, meter_col_w, meter_h, "L", lufs_l, -60, 0, 0/255,150/255,130/255);
    vx += meter_col_w + meter_col_gap;
    draw_vertical_complex_meter(vx, meters_start_y, meter_col_w, meter_h, "RMS", rms_all_db, rms_low_db, rms_mid_db, rms_high_db);
  ) : (
    draw_tp_peak_meter(meter_x,my,meter_w,meter_h,"TP dBTP",tp_db_state_l,tp_db_state_r,tp_hold_l,tp_hold_r,-60,6,tp_clip); my += meter_h+meter_gap;
    draw_level_meter(meter_x,my,meter_w,meter_h,"LUFS M",lufs_m,-60,0,0/255,230/255,160/255); my += meter_h+meter_gap;
    draw_level_meter(meter_x,my,meter_w,meter_h,"LUFS S",lufs_s,-60,0,0/255,190/255,150/255); my += meter_h+meter_gap;
    draw_level_meter(meter_x,my,meter_w,meter_h,"LUFS L",lufs_l,-60,0,0/255,150/255,130/255); my += meter_h+meter_gap;
    my += 16 * scale;
    draw_complex_meter(meter_x, my, meter_w, meter_h, "RMS", "", 0, rms_all_db, rms_low_db, rms_mid_db, rms_high_db, 1, 1);
  );
);

lbl_y_base = is_embedded ? gfx_h : gfx_h - total_bot_h;

gfx_r=65/255; gfx_g=65/255; gfx_b=65/255; gfx_a = 1.0;
x1_xover >= spec_x && x1_xover <= spec_x + spec_w ? gfx_rect(x1_xover - 1, spec_y, 3, fft_plot_h);

gfx_setfont(3);
sprintf(#lbl1, "%d Hz", slider4);
gfx_measurestr(#lbl1, sw, sh);
x1_xover >= spec_x && x1_xover <= spec_x + spec_w ? (
  fill_roundrect(x1_xover - sw/2 - 6*scale, spec_y + 2*scale, sw + 12*scale, sh + 8*scale, 4*scale);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1.0; 
  gfx_x = x1_xover - sw/2; gfx_y = spec_y + 6*scale; gfx_drawstr(#lbl1);
);

gfx_r=65/255; gfx_g=65/255; gfx_b=65/255; gfx_a = 1.0;
x2_xover >= spec_x && x2_xover <= spec_x + spec_w ? gfx_rect(x2_xover - 1, spec_y, 3, fft_plot_h);

sprintf(#lbl2, "%d Hz", slider5);
gfx_measurestr(#lbl2, sw, sh);
x2_xover >= spec_x && x2_xover <= spec_x + spec_w ? (
  fill_roundrect(x2_xover - sw/2 - 6*scale, spec_y + 2*scale, sw + 12*scale, sh + 8*scale, 4*scale);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1.0; 
  gfx_x = x2_xover - sw/2; gfx_y = spec_y + 6*scale; gfx_drawstr(#lbl2);
);

show_grid ? (
  gfx_setfont(3);

  // One continuous dark translucent label strip for the oscilloscope dB ruler.
  gfx_r=20/255; gfx_g=20/255; gfx_b=20/255; gfx_a=0.62;
  gfx_rect(osc_x+2*scale, osc_y, 40*scale, osc_h);

  g_c_grid = 0;
  loop(draw_ch,
    center_g = osc_y + (g_c_grid * chan_size) + (chan_size / 2);
    ch_scale_g = (chan_size / 2 - (2 * scale)) * (slider13 / 100.0);
    
    step = 0;
    loop(6,
      db = step==0? 0 : (step==1? -6 : (step==2? -12 : (step==3? -18 : (step==4? -24 : -48))));
      amp = 10 ^ (db / 20);
      dy = amp * ch_scale_g;
      y_top = (center_g - dy)|0; y_bot = (center_g + dy)|0;
      
      gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.15;
      y_top > osc_y ? gfx_line(osc_x, y_top, osc_x + osc_w, y_top); 
      db != 0 && y_bot < osc_y + osc_h ? gfx_line(osc_x, y_bot, osc_x + osc_w, y_bot);
      
      sprintf(#db_str, "%d", db);
      gfx_measurestr(#db_str, str_w, str_h);
      pad_x = 2 * scale; pad_y = 1 * scale; bg_w = str_w + (pad_x * 2); bg_h = str_h + (pad_y * 2);
      
      txt_x = osc_x + 5 * scale; txt_y = y_top - str_h/2;
      y_top > osc_y + str_h ? (
        gfx_r = 20/255; gfx_g = 20/255; gfx_b = 20/255; gfx_a = 170/255;
        gfx_rect(txt_x - pad_x, txt_y - pad_y, bg_w, bg_h);
        gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.5; gfx_x = txt_x; gfx_y = txt_y; gfx_drawstr(#db_str);
      );
      
      db != 0 && y_bot < osc_y + osc_h - str_h ? (
        txt_y = y_bot - str_h/2;
        gfx_r = 20/255; gfx_g = 20/255; gfx_b = 20/255; gfx_a = 170/255;
        gfx_rect(txt_x - pad_x, txt_y - pad_y, bg_w, bg_h);
        gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.5; gfx_x = txt_x; gfx_y = txt_y; gfx_drawstr(#db_str);
      );
      step += 1;
    );
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.3;
    gfx_line(osc_x, center_g, osc_x + osc_w, center_g);
    g_c_grid += 1;
  );

  db = 0;
  while(db >= slider15) (
    ty = fft_db_to_y(db, slider15, fft_headroom_db, spec_y, fft_plot_h);
    ty < spec_y + fft_plot_h ? (
      gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.08; gfx_line(spec_x, ty, spec_x + spec_w, ty);
      sprintf(#dbstr, "%d", db);
      gfx_measurestr(#dbstr, sw, sh);
      gfx_a=0.3; gfx_x = spec_x + 5*scale; gfx_y = ty - sh/2; gfx_drawstr(#dbstr);
    );
    db -= 12;
  );
  f = 10;
  while (f < srate*0.5) (
    grid_norm = log(1.0 + (f/srate*2.0)*400) / fft_log_span;
    tx = spec_x + ((grid_norm - fft_zoom_start_draw) / fft_zoom_span_draw) * spec_w;
    tx >= spec_x && tx <= spec_x + spec_w ? (
      gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.08; gfx_line(tx, spec_y, tx, spec_y + fft_plot_h);
      // Dense but controlled logarithmic labels: 1/2/3/4/5/7 per decade.
      label_hit = f < 100 ? (f==10 || f==20 || f==30 || f==40 || f==50 || f==70) :
                  f < 1000 ? (f%100 == 0 && ((f/100)==1 || (f/100)==2 || (f/100)==3 || (f/100)==4 || (f/100)==5 || (f/100)==7)) :
                  f < 10000 ? (f%1000 == 0 && ((f/1000)==1 || (f/1000)==2 || (f/1000)==3 || (f/1000)==4 || (f/1000)==5 || (f/1000)==7)) :
                  (f%10000 == 0);
      label_hit ? (
        f >= 1000 ? sprintf(#fstr, "%.0fk", f/1000) : sprintf(#fstr, "%.0f", f);
        gfx_measurestr(#fstr, sw, sh);
        txt_x = tx - sw/2;
        txt_x < spec_x + 2*scale ? txt_x = spec_x + 2*scale;
        gfx_a=0.3; gfx_x = txt_x; gfx_y = spec_y + fft_plot_h - sh - (5*scale); gfx_drawstr(#fstr);
      );
    );
    f += (f<100 ? 10 : f<1000 ? 100 : f<10000 ? 1000 : 5000);
  );
);

!is_embedded ? (
  gfx_setfont(1);
  gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.08; gfx_a = 1.0; 
  gfx_rect(0, 0, gfx_w, ui_h); 
  gfx_rect(0, mid_y, sidebar_x, mid_h); 
  gfx_rect(0, gfx_h - total_bot_h, gfx_w, total_bot_h); 
  
  top_show_osc_mode ? (
    slider2 == 0 ? sprintf(#osc_mode_txt, "OSC: MONO") :
    slider2 == 1 ? sprintf(#osc_mode_txt, "OSC: STEREO") :
    slider2 == 3 ? sprintf(#osc_mode_txt, "OSC: M/S") :
                   sprintf(#osc_mode_txt, "OSC: MULTI");
    draw_btn(bx_osc_mode, tby, osc_mode_w, tbh, #osc_mode_txt, 1, peak_r, peak_g, peak_b, btn_r, 0.25);
  );
  top_show_grid ? draw_btn(bx_grid, tby, tbw, tbh, "GRID", show_grid, 0.8, 0.8, 0.8, btn_r, 0.25);
  
  // Value knobs use 0.75 for bright idle text
  top_show_time ? (
    sprintf(#time_txt, "TIME %.0fms", samples_to_draw * 1000 / srate);
    draw_btn(bx_time, tby, time_w, tbh, #time_txt, drag_mode==4, peak_r, peak_g, peak_b, btn_r, 0.5);
  );
  top_show_zoom ? (
    sprintf(#zoom_str, "ZOOM %d%%", slider13);
    draw_btn(bx_zoom, tby, zoom_w, tbh, #zoom_str, drag_mode==3, peak_r, peak_g, peak_b, btn_r, 0.5);
  );

  mid_bar_visible ? (
    mid_core_visible ? (
      fft_view == 0 ? sprintf(#fft_view_str, "FFT: UNITE") :
      fft_view == 1 ? sprintf(#fft_view_str, "FFT: STEREO") :
                      sprintf(#fft_view_str, "FFT: M/S");
      draw_btn(fft_view_x, mid_by, fft_view_w, tbh, #fft_view_str, fft_view != 0, peak_r, peak_g, peak_b, btn_r, 0.35);
      bx_fft + fft_w <= main_w ? (
        sprintf(#fft_txt, "FFT: %d", 1024 << slider14);
        draw_btn(bx_fft, mid_by, fft_w, tbh, #fft_txt, 0, peak_r, peak_g, peak_b, btn_r, 0.5);
      );
      bx_floor + floor_w <= main_w ? (
        sprintf(#floor_txt, "FLOOR: %ddB", slider15);
        draw_btn(bx_floor, mid_by, floor_w, tbh, #floor_txt, drag_mode==5, peak_r, peak_g, peak_b, btn_r, 0.5);
      );
    );
    mid_aux_visible ? (
      bx_snow + snow_w <= main_w ? (
        gfx_setfont(4);
        slider22 == 2 ? (snow_r=0.10; snow_g=0.65; snow_b=1.0;) : slider22 == 1 ? (snow_r=0.82; snow_g=0.82; snow_b=0.82;) : (snow_r=0.25; snow_g=0.25; snow_b=0.25;);
        draw_btn(bx_snow, mid_by, snow_w, tbh, "❆", slider22 > 0, snow_r, snow_g, snow_b, btn_r, 0.25);
        gfx_setfont(1);
      );
    );

    mid_aux_visible && slider25 > 0 ? (
      gfx_setfont(3);
      gfx_r = 0.11; gfx_g = 0.11; gfx_b = 0.11; gfx_a = 1;
      fill_roundrect(fft_pan_track_x, fft_pan_track_y, fft_pan_track_w, fft_pan_track_h, 3 * scale);
      gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.20; gfx_a = 1;
      gfx_roundrect_border(fft_pan_track_x, fft_pan_track_y, fft_pan_track_w, fft_pan_track_h, 3 * scale, 1);
      gfx_r = 0.34; gfx_g = 0.34; gfx_b = 0.34; gfx_a = 0.8;
      gfx_rect(fft_pan_track_x + fft_pan_track_w * 0.5, fft_pan_track_y + 2 * scale, 1 * scale, max(1, fft_pan_track_h - 4 * scale));
      pan_norm = (fft_pan_display + 1) * 0.5;
      pan_knob_x = fft_pan_track_x + pan_norm * fft_pan_track_w;
      pan_cy = mid_by + tbh * 0.5;
      fft_view == 1 ? (
        gfx_measurestr("L", tw, th); gfx_r = fft_mint_r; gfx_g = fft_mint_g; gfx_b = fft_mint_b; gfx_a = 0.9; gfx_x = fft_pan_x + 4 * scale; gfx_y = pan_cy + 2*scale - th * 0.5; gfx_drawstr("L");
        gfx_measurestr("R", tw, th); gfx_r = fft_peach_r; gfx_g = fft_peach_g; gfx_b = fft_peach_b; gfx_a = 0.9; gfx_x = fft_pan_x + fft_pan_w - tw - 4 * scale; gfx_y = pan_cy + 2*scale - th * 0.5; gfx_drawstr("R");
        focus = abs(fft_pan_display);
        knob_r = fft_gray_r * (1 - focus) + ((fft_pan_display < 0) ? fft_mint_r : fft_peach_r) * focus;
        knob_g = fft_gray_g * (1 - focus) + ((fft_pan_display < 0) ? fft_mint_g : fft_peach_g) * focus;
        knob_b = fft_gray_b * (1 - focus) + ((fft_pan_display < 0) ? fft_mint_b : fft_peach_b) * focus;
      ) : (
        gfx_measurestr("M", tw, th); gfx_r = fft_mid_r; gfx_g = fft_mid_g; gfx_b = fft_mid_b; gfx_a = 0.9; gfx_x = fft_pan_x + 4 * scale; gfx_y = pan_cy + 2*scale - th * 0.5; gfx_drawstr("M");
        gfx_measurestr("S", tw, th); gfx_r = fft_mint_r; gfx_g = fft_mint_g; gfx_b = fft_mint_b; gfx_a = 0.9; gfx_x = fft_pan_x + fft_pan_w - tw - 4 * scale; gfx_y = pan_cy + 2*scale - th * 0.5; gfx_drawstr("S");
        focus = abs(fft_pan_display);
        knob_r = fft_gray_r * (1 - focus) + ((fft_pan_display > 0) ? fft_mint_r : 0.82) * focus;
        knob_g = fft_gray_g * (1 - focus) + ((fft_pan_display > 0) ? fft_mint_g : 0.82) * focus;
        knob_b = fft_gray_b * (1 - focus) + ((fft_pan_display > 0) ? fft_mint_b : 0.82) * focus;
      );
      knob_w = 6 * scale; knob_h = 12 * scale;
      gfx_r = 0.29; gfx_g = 0.29; gfx_b = 0.29; gfx_a = 1;
      fill_roundrect(pan_knob_x - knob_w * 0.5, pan_cy - knob_h * 0.5, knob_w, knob_h, 2 * scale);
      gfx_r = 0.45; gfx_g = 0.45; gfx_b = 0.45; gfx_a = 0.75;
      gfx_roundrect_border(pan_knob_x - knob_w * 0.5, pan_cy - knob_h * 0.5, knob_w, knob_h, 2 * scale, 1);
      gfx_setfont(1);
    );

    mid_band_visible ? (
      bx_l + bw <= main_w ? draw_btn_shape(bx_l, band_by, bw, band_h, "LOW", slider6, 0/255, 91/255, 143/255, btn_r, 0.25, 1);
      bx_ls + sw_solo <= main_w ? draw_btn_shape(bx_ls, band_by, sw_solo, band_h, "S", slider9, 255/255, 40/255, 40/255, btn_r, 0.25, 2);
      bx_m + bw <= main_w ? draw_btn_shape(bx_m, band_by, bw, band_h, "MID", slider7, 162/255, 0/255, 100/255, btn_r, 0.25, 1);
      bx_ms + sw_solo <= main_w ? draw_btn_shape(bx_ms, band_by, sw_solo, band_h, "S", slider10, 255/255, 40/255, 40/255, btn_r, 0.25, 2);
      bx_h + bw <= main_w ? draw_btn_shape(bx_h, band_by, bw, band_h, "HIGH", slider8, 255/255, 210/255, 0/255, btn_r, 0.25, 1);
      bx_hs + sw_solo <= main_w ? draw_btn_shape(bx_hs, band_by, sw_solo, band_h, "S", slider11, 255/255, 40/255, 40/255, btn_r, 0.25, 2);
    );

    // Right-column lock + manual collapse controls at the end of the middle bar.
    sidebar_enabled ? (
      gfx_setfont(4);
      draw_btn_shape(lock_btn_x, collapse_btn_y, lock_btn_w, lock_btn_h, "🔒", slider27, peak_r, peak_g, peak_b, btn_r, 0.25, 1);
      draw_btn_shape(collapse_btn_x, collapse_btn_y, collapse_btn_w, collapse_btn_h, "❯", slider28, peak_r, peak_g, peak_b, btn_r, 0.25, 2);
      gfx_setfont(1);
    );
  );

  // Draw FM TotalView in its original far-right position.
  top_title_visible ? (
    gfx_setfont(4);
    gfx_r = 0.3; gfx_g = 0.3; gfx_b = 0.3; gfx_a = 1.0;
    gfx_x = top_title_x;
    gfx_y = tby + (tbh - title_h) / 2;
    gfx_drawstr(#title_str);
  );

);

// --- FFT HORIZONTAL ZOOM SCROLLBAR ---
fft_zoombar_visible ? (
  // Draw the thumb from the animated zoom state so a double-click reset
  // visibly expands it back to the full FFT range instead of snapping.
  fft_zoom_span_draw = 1.0 / max(1.0, fft_zoom_display);
  fft_zoom_span_draw = max(1.0 / fft_zoom_max, min(1.0, fft_zoom_span_draw));
  fft_zoom_start_draw = max(0, min(1.0 - fft_zoom_span_draw, fft_zoom_start_display));

  // Opaque slider: no alpha skeletons. Idle thumb is only slightly brighter than
  // the surrounding background, then smoothly brightens on hover/drag.
  gfx_r=0.09; gfx_g=0.09; gfx_b=0.09; gfx_a=1;
  fill_roundrect(fft_zoombar_x, fft_zoombar_y, fft_zoombar_w, fft_zoombar_h, 3*scale);
  zoom_idle = 0.11;
  zoom_active = 0.34;
  zoom_col = zoom_idle + (zoom_active - zoom_idle) * fft_zoom_brightness;
  zoom_thumb_x = fft_zoombar_x + fft_zoom_start_draw * fft_zoombar_w;
  zoom_thumb_w = max(10*scale, fft_zoom_span_draw * fft_zoombar_w);
  gfx_r=zoom_col; gfx_g=zoom_col; gfx_b=zoom_col; gfx_a=1;
  fill_roundrect(zoom_thumb_x, fft_zoombar_y, zoom_thumb_w, fft_zoombar_h, 3*scale);
  border_col = zoom_col + 0.10;
  border_col > 0.55 ? border_col = 0.55;
  gfx_r=border_col; gfx_g=border_col; gfx_b=border_col; gfx_a=1;
  gfx_roundrect_border(zoom_thumb_x, fft_zoombar_y, zoom_thumb_w, fft_zoombar_h, 3*scale, 1);
);

// --- Priority Buttons ---
gfx_setfont(3);
priority_btn_y = 8 * scale;
priority_btn_x_osc = osc_x + osc_w - priority_btn_w - 6 * scale;
priority_btn_x_spec = spec_x + spec_w - priority_btn_w - 6 * scale;
gfx_setfont(4);
draw_btn(priority_btn_x_osc, osc_y + priority_btn_y, priority_btn_w, priority_btn_h, "⛶", osc_priority, peak_r, peak_g, peak_b, 4 * scale, 0.25);
draw_btn(priority_btn_x_spec, spec_y + priority_btn_y, priority_btn_w, priority_btn_h, "⛶", spec_priority, peak_r, peak_g, peak_b, 4 * scale, 0.25);

// --- HOVER HELP IN THE BOTTOM BAR ---
tooltip_id = 0;

// Give small buttons priority over their containing analyzer regions.
!is_embedded && mouse_x >= priority_btn_x_osc && mouse_x <= priority_btn_x_osc + priority_btn_w && mouse_y >= osc_y + priority_btn_y && mouse_y <= osc_y + priority_btn_y + priority_btn_h ? tooltip_id = 1;
!is_embedded && mouse_x >= priority_btn_x_spec && mouse_x <= priority_btn_x_spec + priority_btn_w && mouse_y >= spec_y + priority_btn_y && mouse_y <= spec_y + priority_btn_y + priority_btn_h ? tooltip_id = 2;

!is_embedded && sidebar_enabled && slider29 < 0.5 && mouse_y >= gonio_btn_y && mouse_y <= gonio_btn_y + 16*scale && mouse_x >= gonio_btn_x && mouse_x <= gonio_btn_x + gonio_btn_w*4 ? tooltip_id = 3;
!is_embedded && sidebar_enabled && slider29 < 0.5 && tooltip_id == 0 && mouse_x >= gx+4*scale && mouse_x <= gx+gw-4*scale && mouse_y >= gonio_start_y && mouse_y <= gonio_start_y+gh ? tooltip_id = 4;
!is_embedded && sidebar_enabled && slider29 >= 0.5 && tooltip_id == 0 && mouse_x >= tree_plot_x && mouse_x <= tree_plot_x+tree_plot_w && mouse_y >= tree_plot_top && mouse_y <= tree_plot_top+tree_plot_h ? tooltip_id = 22;
!is_embedded && sidebar_enabled && tree_splitter_active && mouse_x >= gx && mouse_x <= gx+gw && mouse_y >= tree_splitter_y-6*scale && mouse_y <= tree_splitter_y+tree_splitter_h ? tooltip_id = 23;
!is_embedded && sidebar_enabled && mouse_x >= style_toggle_x && mouse_x <= style_toggle_x+style_toggle_w && mouse_y >= style_toggle_y && mouse_y <= style_toggle_y+tree_toggle_h ? tooltip_id = 24;
!is_embedded && sidebar_enabled && mouse_x >= tree_toggle_x && mouse_x <= tree_toggle_x+tree_toggle_w && mouse_y >= tree_toggle_y && mouse_y <= tree_toggle_y+tree_toggle_h ? tooltip_id = 21;

!is_embedded && top_show_osc_mode && mouse_x >= bx_osc_mode && mouse_x <= bx_osc_mode + osc_mode_w && mouse_y >= tby && mouse_y <= tby + tbh ? tooltip_id = 5;
!is_embedded && top_show_grid && mouse_x >= bx_grid && mouse_x <= bx_grid + tbw && mouse_y >= tby && mouse_y <= tby + tbh ? tooltip_id = 6;
!is_embedded && top_show_time && mouse_x >= bx_time && mouse_x <= bx_time + time_w && mouse_y >= tby && mouse_y <= tby + tbh ? tooltip_id = 7;

fft_zoombar_visible && mouse_x >= fft_zoombar_x && mouse_x <= fft_zoombar_x + fft_zoombar_w && mouse_y >= fft_zoombar_y && mouse_y <= fft_zoombar_y + fft_zoombar_h ? tooltip_id = 12;

mid_bar_visible && mouse_y >= mid_by && mouse_y <= mid_by + tbh ? (
  mid_core_visible && mouse_x >= fft_view_x && mouse_x <= fft_view_x + fft_view_w ? tooltip_id = 9;
  mid_aux_visible && mouse_x >= bx_snow && mouse_x <= bx_snow + snow_w ? tooltip_id = 11;
  mid_aux_visible && slider25 > 0 && mouse_x >= fft_pan_x && mouse_x <= fft_pan_x + fft_pan_w ? tooltip_id = 10;
  mid_band_visible && mouse_y >= band_by && mouse_y <= band_by + band_h ? (
    mouse_x >= bx_l && mouse_x <= bx_l + bw ? tooltip_id = 13;
    mouse_x >= bx_ls && mouse_x <= bx_ls + sw_solo ? tooltip_id = 14;
    mouse_x >= bx_m && mouse_x <= bx_m + bw ? tooltip_id = 15;
    mouse_x >= bx_ms && mouse_x <= bx_ms + sw_solo ? tooltip_id = 16;
    mouse_x >= bx_h && mouse_x <= bx_h + bw ? tooltip_id = 17;
    mouse_x >= bx_hs && mouse_x <= bx_hs + sw_solo ? tooltip_id = 18;
  );
);

mid_bar_visible && sidebar_enabled && mouse_x >= collapse_btn_x && mouse_x <= collapse_btn_x + collapse_btn_w && mouse_y >= collapse_btn_y && mouse_y <= collapse_btn_y + collapse_btn_h ? tooltip_id = 19;
mid_bar_visible && sidebar_enabled && mouse_x >= lock_btn_x && mouse_x <= lock_btn_x + lock_btn_w && mouse_y >= lock_btn_y && mouse_y <= lock_btn_y + lock_btn_h ? tooltip_id = 20;

tooltip_id == 0 && !is_embedded && mouse_x >= osc_x && mouse_x <= osc_x + osc_w && mouse_y >= osc_y && mouse_y < osc_y + osc_h ? tooltip_id = 8;

tooltip_target_id=tooltip_id;
tooltip_now=time_precise();
tooltip_dt=max(0,min(0.10,tooltip_now-tooltip_fade_last_t));
tooltip_fade_last_t=tooltip_now;
tooltip_target_id != tooltip_display_id && tooltip_fade > 0.001 ? (
  tooltip_fade=max(0,tooltip_fade-8*tooltip_dt);
  tooltip_fade < 0.01 ? tooltip_display_id=tooltip_target_id;
) : (
  tooltip_display_id=tooltip_target_id;
  tooltip_fade += ((tooltip_display_id>0 ? 1 : 0)-tooltip_fade)*(1-exp(-tooltip_dt/0.09));
);
tooltip_id=tooltip_display_id;

tooltip_id == 1 ? (
  sprintf(#tooltip_line1, "Expand the oscilloscope to fullscreen.");
  sprintf(#tooltip_line2, "Click again to restore the split view.");
) : tooltip_id == 2 ? (
  sprintf(#tooltip_line1, "Expand the spectrum analyzer to fullscreen.");
  sprintf(#tooltip_line2, "Click again to restore the split view.");
) : tooltip_id == 3 ? (
  sprintf(#tooltip_line1, "Show or hide RAW and individual frequency-band layers.");
  sprintf(#tooltip_line2, "These buttons affect the goniometer display.");
) : tooltip_id == 4 ? (
  sprintf(#tooltip_line1, "Scroll to zoom in or out; double-click to reset to 100%%.");
  sprintf(#tooltip_line2, "Use the top buttons to show or hide frequency bands.");
) : tooltip_id == 5 ? (
  sprintf(#tooltip_line1, "Cycle through Mono, Stereo, Mid/Side, and Multichannel.");
  sprintf(#tooltip_line2, "LOW/MID/HIGH toggle bands; drag FFT markers to set crossovers.");
) : tooltip_id == 6 ? (
  sprintf(#tooltip_line1, "Show or hide the analyzer grid lines.");
  sprintf(#tooltip_line2, "Applies to both the oscilloscope and FFT analyzer.");
) : tooltip_id == 7 ? (
  sprintf(#tooltip_line1, "Drag vertically to change the visible oscilloscope time range.");
  sprintf(#tooltip_line2, "Double-click to reset the range to 5000 ms.");
) : tooltip_id == 8 ? (
  sprintf(#tooltip_line1, "Scroll to set the time range; hold mouseclick and drag vertically to freeze and zoom.");
  sprintf(#tooltip_line2, "The FFT spectrum follows the waveform at the SCAN cursor.");
) : tooltip_id == 9 ? (
  sprintf(#tooltip_line1, "Switch between Unite, Stereo, and Mid/Side spectrum views.");
  sprintf(#tooltip_line2, "In Stereo or Mid/Side, use Pan to balance channel visibility.");
) : tooltip_id == 10 ? (
  sprintf(#tooltip_line1, "Adjust Left/Right visibility in Stereo mode.");
  sprintf(#tooltip_line2, "Adjust Mid/Side visibility in Mid/Side mode.");
) : tooltip_id == 11 ? (
  sprintf(#tooltip_line1, "Cycle through Off, slow-release peak hold, and full freeze.");
  sprintf(#tooltip_line2, "Peak traces show the recent maximum FFT level.");
) : tooltip_id == 12 ? (
  sprintf(#tooltip_line1, "Scroll over the analyzer to zoom; drag the thumb to pan.");
  sprintf(#tooltip_line2, "Double-click the scrollbar to reset to the full spectrum.");
) : tooltip_id == 13 ? (
  sprintf(#tooltip_line1, "Show or hide the LOW band trace in the oscilloscope.");
  sprintf(#tooltip_line2, "This changes display visibility, not the audio signal.");
) : tooltip_id == 14 ? (
  sprintf(#tooltip_line1, "Solo the LOW band in the output.");
  sprintf(#tooltip_line2, "Combine solo bands; selecting all three clears solo.");
) : tooltip_id == 15 ? (
  sprintf(#tooltip_line1, "Show or hide the MID band trace in the oscilloscope.");
  sprintf(#tooltip_line2, "This changes display visibility, not the audio signal.");
) : tooltip_id == 16 ? (
  sprintf(#tooltip_line1, "Solo the MID band in the output.");
  sprintf(#tooltip_line2, "Combine solo bands; selecting all three clears solo.");
) : tooltip_id == 17 ? (
  sprintf(#tooltip_line1, "Show or hide the HIGH band trace in the oscilloscope.");
  sprintf(#tooltip_line2, "This changes display visibility, not the audio signal.");
) : tooltip_id == 18 ? (
  sprintf(#tooltip_line1, "Solo the HIGH band in the output.");
  sprintf(#tooltip_line2, "Combine solo bands; selecting all three clears solo.");
) : tooltip_id == 19 ? (
  sprintf(#tooltip_line1, "Collapse or expand the right column.");
  sprintf(#tooltip_line2, "The column contains the goniometer and meters.");
) : tooltip_id == 20 ? (
  sprintf(#tooltip_line1, "Lock the right column open while an analyzer is fullscreen.");
  sprintf(#tooltip_line2, "When locked, fullscreen mode will not auto-collapse it.");
) : tooltip_id == 21 ? (
  sprintf(#tooltip_line1, "Switch between the Goniometer and Tree views.");
  sprintf(#tooltip_line2, "The Tree keeps the same frequency and pan information at every width.");
) : tooltip_id == 22 ? (
  sprintf(#tooltip_line1, "Side FFT sets width; the center trace also shows Mid energy.");
  sprintf(#tooltip_line2, "Edge lines hold recent peaks; red marks reversed phase.");
) : tooltip_id == 23 ? (
  sprintf(#tooltip_line1, "Drag to resize the Tree and meter areas.");
  sprintf(#tooltip_line2, "Double-click the divider to restore the 4:3 Tree-to-meter split.");
) : tooltip_id == 24 ? (
  slider29 >= 0.5 ? (
    sprintf(#tooltip_line1, "Cycle through STRIPS, DUST, and LINES Tree styles.");
    sprintf(#tooltip_line2, "Each style uses the same calibrated stereo data.");
  ) : (
    sprintf(#tooltip_line1, "Switch between the Goniometer lasso and dust styles.");
    sprintf(#tooltip_line2, "Dust adds a soft particle trail around the measured signal.");
  );
) : tooltip_id == 25 ? (
  sprintf(#tooltip_line1, "Show a one-sided level history, similar to a volume envelope.");
  sprintf(#tooltip_line2, "Turn it off to see the signed waveform around zero with bright band outlines.");
);



tooltip_id > 0 && tooltip_fade > 0.005 ? (
  gfx_setfont(3);
  gfx_measurestr(#tooltip_line1, tooltip_w1, tooltip_h);
  gfx_measurestr(#tooltip_line2, tooltip_w2, tooltip_h2);
  tooltip_y = gfx_h - total_bot_h + (total_bot_h - tooltip_h - tooltip_h2) * 0.5;
  gfx_r = 0.72; gfx_g = 0.72; gfx_b = 0.72; gfx_a = tooltip_fade;
  gfx_x = max(6*scale, (gfx_w - tooltip_w1) * 0.5);
  gfx_y = tooltip_y;
  gfx_drawstr(#tooltip_line1);
  gfx_x = max(6*scale, (gfx_w - tooltip_w2) * 0.5);
  gfx_y = tooltip_y + tooltip_h;
  gfx_a = tooltip_fade;
  gfx_drawstr(#tooltip_line2);
  gfx_setfont(1);
);
