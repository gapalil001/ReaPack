  ) : drag_mode == 11 ? (
    tree_split_available_h > 0 ? slider30 = max(tree_split_ratio_min, min(tree_split_ratio_max, (mouse_y - tree_split_top - tree_splitter_h*0.5) / tree_split_available_h));
  );
