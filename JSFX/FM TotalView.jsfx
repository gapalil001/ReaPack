    drag_start_x = mouse_x; drag_start_y = mouse_y;
    drag_start_t = slider1;
    drag_start_samples = samples_to_draw;
    freeze_wpos = active_wpos; 
    is_frozen = 1;
    scroll_offset = 0;
  );
);

(mouse_cap & 1) ? (
  drag_mode == 1 ? (
    delta = (click_y - mouse_y) * 0.01 / scale;
    slider4 = max(20, min(slider5 - 10, drag_start_f * exp(delta)));
    mouse_y >= spec_y && mouse_y <= spec_y + fft_plot_h ? (
      freq_norm_drag = fft_zoom_start + ((mouse_x - spec_x) / max(spec_w,1)) * fft_zoom_span;
      freq_norm_drag = max(0, min(1, freq_norm_drag));
      slider4 = max(20, min(slider5 - 10, (exp(freq_norm_drag * fft_log_span) - 1.0) / 400.0 * srate / 2.0));
    );
  ) : drag_mode == 2 ? (
    delta = (click_y - mouse_y) * 0.01 / scale;
    slider5 = max(slider4 + 10, min(20000, drag_start_f * exp(delta)));
    mouse_y >= spec_y && mouse_y <= spec_y + fft_plot_h ? (
      freq_norm_drag = fft_zoom_start + ((mouse_x - spec_x) / max(spec_w,1)) * fft_zoom_span;
      freq_norm_drag = max(0, min(1, freq_norm_drag));
      slider5 = max(slider4 + 10, min(20000, (exp(freq_norm_drag * fft_log_span) - 1.0) / 400.0 * srate / 2.0));
    );
  ) : drag_mode == 3 ? (
    delta = (drag_start_y - mouse_y) * 0.5 / scale;
    slider13 = max(10, min(200, drag_start_z + delta));
  ) : drag_mode == 4 ? (
    delta = (click_y - mouse_y) * 0.01 / scale;
    slider1 = max(1, min(5000, drag_start_t * exp(delta)));
  ) : drag_mode == 5 ? (
    delta = (mouse_y - drag_start_y) * 0.5 / scale;
    slider15 = max(-450, min(-12, drag_start_v + delta));
  ) : drag_mode == 6 ? (
    is_frozen = 1; 
    v_delta = (drag_start_y - mouse_y) * 0.01 / scale;
    slider1 = max(1, min(5000, drag_start_t * exp(v_delta)));
  ) : drag_mode == 7 ? (
    delta = (drag_start_y - mouse_y) * 2.0 / scale;
    slider20 = max(10, min(1000, drag_start_gz + delta));
  ) : drag_mode == 9 ? (
    fft_pan_norm = max(0, min(1, (mouse_x - fft_pan_track_x) / fft_pan_track_w));
