    dbl_click ? ( fft_zoom = 1.0; fft_zoom_start = 0.0; drag_mode = 0; ) : drag_mode = 8;
  ) :
  click_x >= osc_x && click_x <= osc_x + osc_w && click_y >= osc_y && click_y < osc_y + osc_h ? (
