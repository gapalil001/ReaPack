draw_h_slider(in_x, io_y, sm_w, sm_h, in_gain, -60, 15, "IN", "dB", 0.25,0.25,0.25, 0.7,0.7,0.7, 0);

rad = 6 * scale; gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(clip_btn_x+rad, clip_btn_y, clip_btn_w-rad*2, clip_btn_h); gfx_rect(clip_btn_x, clip_btn_y+rad, clip_btn_w, clip_btn_h-rad*2); 
gfx_circle(clip_btn_x+rad, clip_btn_y+rad, rad, 1, 1); gfx_circle(clip_btn_x+clip_btn_w-rad, clip_btn_y+rad, rad, 1, 1); gfx_circle(clip_btn_x+rad, clip_btn_y+clip_btn_h-rad, rad, 1, 1); gfx_circle(clip_btn_x+clip_btn_w-rad, clip_btn_y+clip_btn_h-rad, rad, 1, 1);


clipper_on == 1 ? (gfx_r=0.8; gfx_g=0.1; gfx_b=0.1;) : (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;); 
gfx_roundrect(clip_btn_x, clip_btn_y, clip_btn_w, clip_btn_h, rad, 1); 
gfx_setfont(1, "Arial", 14 * scale, "b"); gfx_measurestr(clipper_on ? "CLIP: ON" : "CLIP: OFF", tw, th); 
gfx_x = clip_btn_x + (clip_btn_w-tw)/2; gfx_y = clip_btn_y + (5*scale); gfx_drawstr(clipper_on ? "CLIP: ON" : "CLIP: OFF");

// --- NEW CLIPPER VISUALIZER ---
clipper_on == 1 ? (
  // 0.5 second refresh timer
  time_precise() - last_clip_time > 0.5 ? ( 
    disp_clip_peak = clip_peak_db; 
    clip_peak_db = 0; 
    last_clip_time = time_precise(); 
  );
  strip_x = clip_btn_x + 2*scale ;
  strip_y = clip_btn_y + clip_btn_h - 5*scale ; 
  strip_h = 6*scale;
    fill_w = min(clip_env_db / 12.0, 1.0) * clip_btn_w;
  gfx_r=0.9; gfx_g=0.2; gfx_b=0.2; gfx_a=0.9;
  fill_w > 0 ? gfx_rect(strip_x, strip_y, fill_w, strip_h);
  
  // Peak Text
  disp_clip_peak > 0.05 ? sprintf(#c_str, "-%.1f dB", disp_clip_peak) : strcpy(#c_str, "0.0 dB");
  gfx_setfont(1, "Arial", 11 * scale, "b"); 
  gfx_measurestr(#c_str, tw, th);
  gfx_x = clip_btn_x + (clip_btn_w - tw)/2; 
  gfx_y = strip_y + strip_h + 3*scale;
  disp_clip_peak > 0.05 ? (gfx_r=0.9; gfx_g=0.4; gfx_b=0.4;) : (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;);
  gfx_drawstr(#c_str);
);

// ==========================================
// --- COMPRESSOR VISUALIZER (Main Screen)---
// ==========================================
gfx_r=0.12; gfx_g=0.12; gfx_b=0.13; gfx_rect(disp_x, disp_y, disp_size, disp_size);

gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=0.5; i = 0; 
loop(6, y_p = disp_y + (i/5)*disp_size; x_p = disp_x + (i/5)*disp_size; gfx_line(disp_x, y_p, disp_x+disp_size, y_p); gfx_line(x_p, disp_y, x_p, disp_y+disp_size); i += 1; );

display_points = MAX_POINTS; px_step = wave_draw_w / (display_points - 1); start_idx = write_pos - display_points; while(start_idx < 0) ( start_idx += MAX_POINTS; ); sm_factor = 50 / 100.0; sm_coeff = 1.0 - (sm_factor * 0.95);

gfx_r=0.45; gfx_g=0.45; gfx_b=0.45; gfx_a=0.5; val_smooth = wave_buf[start_idx]; i = 0;
loop(display_points, idx = (start_idx + i) % MAX_POINTS; cur_val = wave_buf[idx]; cur_val > val_smooth ? val_smooth = cur_val : val_smooth = val_smooth + sm_coeff * (cur_val - val_smooth); y = top_h + wave_h - min(sqrt(val_smooth) * wave_h, wave_h); gfx_line(wave_x + i * px_step, top_h + wave_h, wave_x + i * px_step, y); i += 1; );

gfx_r=0.85; gfx_g=0.85; gfx_b=0.85; gfx_a=1.0; val_smooth = wave_buf[start_idx]; i = 0; is_drawing = 0;
loop(display_points, idx = (start_idx + i) % MAX_POINTS; cur_val = wave_buf[idx]; cur_val > val_smooth ? val_smooth = cur_val : val_smooth = val_smooth + sm_coeff * (cur_val - val_smooth); y = top_h + wave_h - min(sqrt(val_smooth) * wave_h, wave_h); is_drawing == 0 ? ( last_x = wave_x + i * px_step; last_y = y; is_drawing = 1; ) : ( cur_x = wave_x + i * px_step; cur_y = y; gfx_line(last_x, last_y, cur_x, cur_y, 1); gfx_line(last_x, last_y+(1*scale), cur_x, cur_y+(1*scale), 1); last_x = cur_x; last_y = cur_y; ); i += 1; );

gfx_r=0.3; gfx_g=0.5; gfx_b=0.7; gfx_a=0.5; in_smooth = in_wave_buf[start_idx]; i = 0;
loop(display_points, idx = (start_idx + i) % MAX_POINTS; cur_val = in_wave_buf[idx]; cur_val > in_smooth ? in_smooth = cur_val : in_smooth = in_smooth + sm_coeff * (cur_val - in_smooth); y = top_h + wave_h - min(sqrt(in_smooth) * wave_h, wave_h); gfx_line(wave_x + i * px_step, top_h + wave_h, wave_x + i * px_step, y); i += 1; );

gfx_r=0.9; gfx_g=0.1; gfx_b=0.1; gfx_a=0.5; gr_smooth = diff_buf[start_idx]; i = 0;
loop(display_points, idx = (start_idx + i) % MAX_POINTS; cur_gr = diff_buf[idx]; cur_gr < gr_smooth ? gr_smooth = cur_gr : gr_smooth = gr_smooth + sm_coeff * (cur_gr - gr_smooth); gr_smooth < 0.99 ? ( diff_px = (1.0 - sqrt(gr_smooth)) * wave_h; gfx_line(wave_x + i * px_step, top_h, wave_x + i * px_step, top_h + diff_px); ); i += 1; );

gfx_r=1.0; gfx_g=0.2; gfx_b=0.2; gfx_a=1.0; gr_smooth = diff_buf[start_idx]; i = 0; is_drawing = 0;
loop(display_points, idx = (start_idx + i) % MAX_POINTS; cur_gr = diff_buf[idx]; cur_gr < gr_smooth ? gr_smooth = cur_gr : gr_smooth = gr_smooth + sm_coeff * (cur_gr - gr_smooth); gr_smooth < 0.99 ? ( diff_px = (1.0 - sqrt(gr_smooth)) * wave_h; is_drawing == 0 ? ( last_x = wave_x + i * px_step; last_y = top_h + diff_px; is_drawing = 1; ) : ( cur_x = wave_x + i * px_step; cur_y = top_h + diff_px; gfx_line(last_x, last_y, cur_x, cur_y, 1); gfx_line(last_x, last_y+(1*scale), cur_x, cur_y+(1*scale), 1); last_x = cur_x; last_y = cur_y; ); ) : is_drawing = 0; i += 1; );

gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=1; 
px = 0;
in_amp = 0; in_db = -144; d = in_db - thresh; k_h = knee / 2; gr = 0;
d < -k_h ? gr = 0 : d > k_h ? gr = d * (1 - 1/ratio) : gr = ((d + k_h)^2) / (2 * max(knee,0.001)) * (1 - 1/ratio);
out_db = in_db - gr; out_amp = 10^(out_db/20);
last_py = disp_y + disp_size - sqrt(clamp(out_amp, 0, 1)) * disp_size;

loop(disp_size,
  in_amp = px / disp_size;
  in_db = 20 * log10(max(in_amp, 0.00001));
  d = in_db - thresh; k_h = knee / 2; gr = 0;
  d < -k_h ? gr = 0 : d > k_h ? gr = d * (1 - 1/ratio) : gr = ((d + k_h)^2) / (2 * max(knee,0.001)) * (1 - 1/ratio);
  out_db = in_db - gr; out_amp = 10 ^ (out_db / 20);
  py = disp_y + disp_size - sqrt(clamp(out_amp, 0, 1)) * disp_size;

    norm_x = px / disp_size;
    in_amp = norm_x * norm_x; 
  
    in_db = 20 * log10(max(in_amp, 0.00001));
    d = in_db - thresh; k_h = knee / 2; gr = 0;
    d < -k_h ? gr = 0 : d > k_h ? gr = d * (1 - 1/ratio) : gr = ((d + k_h)^2) / (2 * max(knee,0.001)) * (1 - 1/ratio);
    out_db = in_db - gr; out_amp = 10 ^ (out_db / 20);
    
    // The Y-axis remains sqrt warped
    py = disp_y + disp_size - sqrt(clamp(out_amp, 0, 1)) * disp_size;
  
    px > 0 ? (
      gfx_line(disp_x + px - 1, last_py, disp_x + px, py);
      gfx_line(disp_x + px - 1, last_py-(1*scale), disp_x + px, py-(1*scale));
      gfx_line(disp_x + px - 1, last_py+(1*scale), disp_x + px, py+(1*scale));
    );
    last_py = py; px += 1;
);

gfx_r=0.07; gfx_g=0.07; gfx_b=0.075; gfx_a=1.0; i = 0; rad = 8 * scale; loop(12 * scale, gfx_roundrect(disp_x-i, disp_y-i, disp_size+i*2, disp_size+i*2, rad+i, 1); i += 1; ); gfx_r=0.7; gfx_g=0.7; gfx_b=0.7; gfx_a=1.0; i = 0; loop(2 * scale, gfx_roundrect(disp_x+i, disp_y+i, disp_size-i*2, disp_size-i*2, rad, 1); i += 1; );
gfx_setfont(1, "Arial", 16 * scale, "b"); show_grid ? ( i = 0; loop(num_grid, db_val = grid_v[i]; amp_val = exp(db_val * db2log); y_line = disp_y + disp_size - (sqrt(amp_val) * disp_size); gfx_r=1.0; gfx_g=1.0; gfx_b=1.0; gfx_a=0.5; sprintf(#db_str, "%d", db_val); gfx_x = disp_x-(10*scale)+ 15*scale; gfx_y = y_line; gfx_drawstr(#db_str); i += 1; ); );

// --- DRAW BOTTOM COMP SLIDERS ---
draw_h_slider(kn_x, kn_y, kn_w, kn_h, knee, 0, 24, "KNEE", "dB", 0.4, 0.4, 0.4, 1.0, 1.0, 0.7, 0);
