draw_comp_strip("FET",  lbl_x, att_x, sy2, ar_w, 0.02, 0.8, 0.01, 500,  0.9, 0.6, 0.1, 1); draw_comp_strip("", lbl_x, rel_x, sy2, ar_w, 50, 1100, 0.1, 10000,  0.9, 0.6, 0.1, 0);
draw_comp_strip("VCA",  lbl_x, att_x, sy3, ar_w, 0.1, 30, 0.01, 500,    0.8, 0.2, 0.5, 1); draw_comp_strip("", lbl_x, rel_x, sy3, ar_w, 100, 1200, 0.1, 10000, 0.8, 0.2, 0.5, 0);

rad = 6 * scale; gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(btn_x+rad, btn_y, btn_w-rad*2, btn_h); gfx_rect(btn_x, btn_y+rad, btn_w, btn_h-rad*2); gfx_circle(btn_x+rad, btn_y+rad, rad, 1, 1); gfx_circle(btn_x+btn_w-rad, btn_y+rad, rad, 1, 1); gfx_circle(btn_x+rad, btn_y+btn_h-rad, rad, 1, 1); gfx_circle(btn_x+btn_w-rad, btn_y+btn_h-rad, rad, 1, 1);
link_btn == 1 ? (gfx_r=0.2; gfx_g=0.8; gfx_b=0.2;) : (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;); gfx_roundrect(btn_x, btn_y, btn_w, btn_h, rad, 1); gfx_setfont(1, "Arial", 14 * scale, "b"); gfx_measurestr("LINK: ON", tw, th); gfx_x = btn_x + (btn_w-tw)/2; gfx_y = btn_y + (5*scale); link_btn == 1 ? gfx_drawstr("LINK: ON") : gfx_drawstr("LINK: OFF");

gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(sc_btn_x+rad, sc_btn_y, sc_btn_w-rad*2, sc_btn_h); gfx_rect(sc_btn_x, sc_btn_y+rad, sc_btn_w, sc_btn_h-rad*2); gfx_circle(sc_btn_x+rad, sc_btn_y+rad, rad, 1, 1); gfx_circle(sc_btn_x+sc_btn_w-rad, sc_btn_y+rad, rad, 1, 1); gfx_circle(sc_btn_x+rad, sc_btn_y+sc_btn_h-rad, rad, 1, 1); gfx_circle(sc_btn_x+sc_btn_w-rad, sc_btn_y+sc_btn_h-rad, rad, 1, 1);
gfx_r=0.35; gfx_g=0.35; gfx_b=0.35; gfx_a=1.0; gfx_roundrect(sc_btn_x, sc_btn_y, sc_btn_w, sc_btn_h, rad, 1); sc_ch > 0 ? (gfx_r=0.2; gfx_g=0.6; gfx_b=0.9;) : (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;); sc_ch == 0 ? strcpy(#sc_str, "SC: Main 1/2") : sc_ch == 1 ? strcpy(#sc_str, "SC: Aux 3/4") : sc_ch == 2 ? strcpy(#sc_str, "SC: Aux 5/6") : strcpy(#sc_str, "SC: Aux 7/8");
gfx_measurestr(#sc_str, tw, th); gfx_x = sc_btn_x + (sc_btn_w-tw)/2; gfx_y = sc_btn_y + (5*scale); gfx_drawstr(#sc_str);
gfx_x = sc_btn_x + sc_btn_w - (15*scale); gfx_y = sc_btn_y + (10*scale); gfx_triangle(gfx_x, gfx_y, gfx_x + (8*scale), gfx_y, gfx_x + (4*scale), gfx_y + (4*scale));

// --- L/R & M/S BUTTONS ---
gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(mode_btn_x+rad, mode_btn_y, mode_btn_w-rad*2, mode_btn_h); gfx_rect(mode_btn_x, mode_btn_y+rad, mode_btn_w, mode_btn_h-rad*2); 
gfx_circle(mode_btn_x+rad, mode_btn_y+rad, rad, 1, 1); gfx_circle(mode_btn_x+mode_btn_w-rad, mode_btn_y+rad, rad, 1, 1); gfx_circle(mode_btn_x+rad, mode_btn_y+mode_btn_h-rad, rad, 1, 1); gfx_circle(mode_btn_x+mode_btn_w-rad, mode_btn_y+mode_btn_h-rad, rad, 1, 1);
stereo_mode == 1 ? (gfx_r=0.2; gfx_g=0.6; gfx_b=0.9;) : (gfx_r=0.35; gfx_g=0.35; gfx_b=0.35;); gfx_roundrect(mode_btn_x, mode_btn_y, mode_btn_w, mode_btn_h, rad, 1); 
gfx_setfont(1, "Arial", 14 * scale, "b"); stereo_mode == 1 ? strcpy(#md_str, "STEREO: M/S") : strcpy(#md_str, "STEREO: L/R"); gfx_measurestr(#md_str, tw, th); gfx_x = mode_btn_x + (mode_btn_w-tw)/2; gfx_y = mode_btn_y + (5*scale); gfx_drawstr(#md_str);

// Left Edit Target
gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(ed_btn_L_x+rad, ed_btn_y, ed_btn_w-rad*2, mode_btn_h); gfx_rect(ed_btn_L_x, ed_btn_y+rad, ed_btn_w, mode_btn_h-rad*2); gfx_circle(ed_btn_L_x+rad, ed_btn_y+rad, rad, 1, 1); gfx_circle(ed_btn_L_x+ed_btn_w-rad, ed_btn_y+rad, rad, 1, 1); gfx_circle(ed_btn_L_x+rad, ed_btn_y+mode_btn_h-rad, rad, 1, 1); gfx_circle(ed_btn_L_x+ed_btn_w-rad, ed_btn_y+mode_btn_h-rad, rad, 1, 1);
edit_target == 0 ? (gfx_r=0.8; gfx_g=0.2; gfx_b=0.2;) : (gfx_r=0.25; gfx_g=0.25; gfx_b=0.25;); gfx_roundrect(ed_btn_L_x, ed_btn_y, ed_btn_w, mode_btn_h, rad, 1); 
stereo_mode == 1 ? strcpy(#edl_str, "MID") : strcpy(#edl_str, "LEFT"); gfx_measurestr(#edl_str, tw, th); gfx_x = ed_btn_L_x + (ed_btn_w-tw)/2; gfx_y = ed_btn_y + (5*scale); gfx_drawstr(#edl_str);

// Link Edit Target
gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(ed_btn_C_x+rad, ed_btn_y, ed_btn_w-rad*2, mode_btn_h); gfx_rect(ed_btn_C_x, ed_btn_y+rad, ed_btn_w, mode_btn_h-rad*2); gfx_circle(ed_btn_C_x+rad, ed_btn_y+rad, rad, 1, 1); gfx_circle(ed_btn_C_x+ed_btn_w-rad, ed_btn_y+rad, rad, 1, 1); gfx_circle(ed_btn_C_x+rad, ed_btn_y+mode_btn_h-rad, rad, 1, 1); gfx_circle(ed_btn_C_x+ed_btn_w-rad, ed_btn_y+mode_btn_h-rad, rad, 1, 1);
edit_target == 1 ? (gfx_r=0.8; gfx_g=0.8; gfx_b=0.2;) : (gfx_r=0.25; gfx_g=0.25; gfx_b=0.25;); gfx_roundrect(ed_btn_C_x, ed_btn_y, ed_btn_w, mode_btn_h, rad, 1); 
strcpy(#edc_str, "LINK"); gfx_measurestr(#edc_str, tw, th); gfx_x = ed_btn_C_x + (ed_btn_w-tw)/2; gfx_y = ed_btn_y + (5*scale); gfx_drawstr(#edc_str);

// Right Edit Target
gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
gfx_rect(ed_btn_R_x+rad, ed_btn_y, ed_btn_w-rad*2, mode_btn_h); gfx_rect(ed_btn_R_x, ed_btn_y+rad, ed_btn_w, mode_btn_h-rad*2); gfx_circle(ed_btn_R_x+rad, ed_btn_y+rad, rad, 1, 1); gfx_circle(ed_btn_R_x+ed_btn_w-rad, ed_btn_y+rad, rad, 1, 1); gfx_circle(ed_btn_R_x+rad, ed_btn_y+mode_btn_h-rad, rad, 1, 1); gfx_circle(ed_btn_R_x+ed_btn_w-rad, ed_btn_y+mode_btn_h-rad, rad, 1, 1);
edit_target == 2 ? (gfx_r=0.2; gfx_g=0.4; gfx_b=0.8;) : (gfx_r=0.25; gfx_g=0.25; gfx_b=0.25;); gfx_roundrect(ed_btn_R_x, ed_btn_y, ed_btn_w, mode_btn_h, rad, 1); 
stereo_mode == 1 ? strcpy(#edr_str, "SIDE") : strcpy(#edr_str, "RIGHT"); gfx_measurestr(#edr_str, tw, th); gfx_x = ed_btn_R_x + (ed_btn_w-tw)/2; gfx_y = ed_btn_y + (5*scale); gfx_drawstr(#edr_str);

draw_tooltip ? (
  gfx_setfont(1, "Arial", 16*scale, 'b'); gfx_measurestr(#tip_txt, tw, th);
  gfx_r=0.1; gfx_g=0.1; gfx_b=0.15; gfx_a=0.9;
  gfx_roundrect(tip_x - tw/2 - 6*scale, tip_y - th/2 - 4*scale, tw + 12*scale, th + 8*scale, 4*scale, 1);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1.0;
  gfx_x = tip_x - tw/2; gfx_y = tip_y - th/2; gfx_drawstr(#tip_txt);
);
