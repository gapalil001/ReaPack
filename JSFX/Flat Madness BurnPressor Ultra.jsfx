      val = (1.0 - clamp((mouse_y - f_y) / sat_sh, 0, 1)) * 100;
      drag_id == 13 ? pre_td = val : drag_id == 14 ? pre_tw = val : drag_id == 15 ? pre_vd = val : drag_id == 16 ? pre_vw = val :
      drag_id == 17 ? pre_fd = val : drag_id == 18 ? pre_fw = val : drag_id == 19 ? post_td = val : drag_id == 20 ? post_tw = val :
      drag_id == 21 ? post_vd = val : drag_id == 22 ? post_vw = val : drag_id == 23 ? post_fd = val : post_fw = val;
    );

    drag_id >= 300 && drag_id <= 311 ? (
      norm = clamp((mouse_x - (drag_id < 306 ? pre_base_x : post_base_x) - sat_sw - 10*scale) / box_s, 0, 1);
      val = inv_log_map(norm, 20, 20000);
      draw_tooltip = 1; tip_x = mouse_x; tip_y = mouse_y - 25*scale; sprintf(#tip_txt, "%.0f Hz", val);
      drag_id == 300 ? pt_hp = clamp(val, 20, pt_lp) : drag_id == 301 ? pt_lp = clamp(val, pt_hp, 20000) :
      drag_id == 302 ? pv_hp = clamp(val, 20, pv_lp) : drag_id == 303 ? pv_lp = clamp(val, pv_hp, 20000) :
      drag_id == 304 ? pf_hp = clamp(val, 20, pf_lp) : drag_id == 305 ? pf_lp = clamp(val, pf_hp, 20000) :
      drag_id == 306 ? xt_hp = clamp(val, 20, xt_lp) : drag_id == 307 ? xt_lp = clamp(val, xt_hp, 20000) :
      drag_id == 308 ? xv_hp = clamp(val, 20, xv_lp) : drag_id == 309 ? xv_lp = clamp(val, xv_hp, 20000) :
      drag_id == 310 ? xf_hp = clamp(val, 20, xf_lp) : xf_lp = clamp(val, xf_hp, 20000);
    );

    drag_id == 27 ? in_gain = -60 + clamp((mouse_x - in_x) / sm_w, 0, 1) * 75;
    drag_id == 28 ? out_gain = -60 + clamp((mouse_x - out_x) / sm_w, 0, 1) * 75;
    
    slider1=thresh; slider2=ratio; slider3=att; slider4=rel; slider5=schp; slider6=sclp; slider7=knee; slider8=dry_pct; 
    slider9=wet_pct; slider10=link_btn; slider11=makeup; slider12=sc_ch; 
    slider13=pre_td; slider14=pre_tw; slider15=pre_vd; slider16=pre_vw; slider17=pre_fd; slider18=pre_fw;
    slider19=post_td; slider20=post_tw; slider21=post_vd; slider22=post_vw; slider23=post_fd; slider24=post_fw;
    slider25=pre_sat_mode; slider26=post_sat_mode; slider27=in_gain; slider28=out_gain;
    slider29=pt_hp; slider30=pt_lp; slider31=pv_hp; slider32=pv_lp; slider33=pf_hp; slider34=pf_lp;
    slider35=xt_hp; slider36=xt_lp; slider37=xv_hp; slider38=xv_lp; slider39=xf_hp; slider40=xf_lp;
    slider41=pre_sat_on; slider42=post_sat_on;
    slider43=pre_t1_type; slider44=pre_t2_type; slider45=pre_t3_type; slider46=post_t1_type; slider47=post_t2_type; slider48=post_t3_type;
    sliderchange(0);
  );
) : ( drag_id = 0; );


// --- BACKGROUND & BACKPLATES ---
gfx_r=0.04; gfx_g=0.04; gfx_b=0.04; gfx_a=1;
gfx_rect(0, 0, gfx_w, gfx_h);

dust_t_ptr = 3500; dust_t_ptr[] += 1.0; dt_time = dust_t_ptr[];
num_dt = 120; dt_w = 260 * scale; dt_h = 45 * scale; dt_i = 1;
gfx_r=1.0; gfx_g=0.2; gfx_b=0.2; 
loop(num_dt,
  rand_x = dt_i * 213.33; rand_y = dt_i * 187.11; speed_rnd = rand_y - floor(rand_y); 
  speed_v = (0.5 + (speed_rnd ^ 2.0) * 2.0) * scale;
  raw_y = dt_time * speed_v + (rand_y * scale); norm_y = raw_y - floor(raw_y / dt_h) * dt_h; dy = dt_h - norm_y; 
  raw_x = (rand_x * scale) + sin(dt_time * 0.03 + dt_i) * (20 * scale); dx = raw_x - floor(raw_x / dt_w) * dt_w;
  fade_y = min(norm_y / (15*scale), (dt_h - norm_y) / (15*scale)); fade_x = min(dx / (30*scale), (dt_w - dx) / (30*scale));
  alpha_rnd = (rand_x * 3.14159) - floor(rand_x * 3.14159); dt_twinkle = 0.4 + sin(dt_time * (0.05 + alpha_rnd * 0.1) + dt_i) * 0.6;
  gfx_a = clamp(fade_y * fade_x * alpha_rnd * dt_twinkle * 2.0, 0.0, 1.0);
  size_rnd = (rand_y * 7.77) - floor(rand_y * 7.77); p_size = max(1, ceil((size_rnd ^ 4.0) * 5.0)) * scale;
  gfx_rect(floor(pre_base_x - 10*scale + dx), floor(y_offs - 5*scale + dy), floor(p_size), floor(p_size)); dt_i += 1;
);

gfx_setfont(1, "Arial", 28 * scale, 'b'); gfx_r=0.9; gfx_g=0.2; gfx_b=0.2; gfx_a=0.8;
gfx_x = pre_base_x; gfx_y = y_offs + 10 * scale; gfx_drawstr("FM BurnPressor"); gfx_setfont(1, "Arial", 14 * scale);

gfx_setfont(1, "Arial", 28 * scale, 'b'); gfx_r=0.7; gfx_g=0.5; gfx_b=0.2; gfx_a=0.8;
gfx_x = pre_base_x + 202*scale; gfx_y = y_offs + 10 * scale; gfx_drawstr("Ultra"); gfx_setfont(1, "Arial", 14 * scale);

function draw_dark_panel(px, py, pw, ph) local(rad) (
  rad = 16 * scale; gfx_r=0.07; gfx_g=0.07; gfx_b=0.07; gfx_a=1.0;
  gfx_circle(px+10*scale, py+10*scale, 10*scale, 10*scale, rad, 1); gfx_circle(px+pw-10*scale, py+10*scale, 10*scale, 10*scale, rad, 1);
  gfx_circle(px+10*scale, py+ph-10*scale, 10*scale, 10*scale, rad, 1); gfx_circle(px+pw-10*scale, py+ph-10*scale, 10*scale, 10*scale, rad, 1);
  gfx_rect(px+7.5*scale, py+1*scale, pw-15*scale, ph-2*scale); gfx_rect(px+2*scale, py+7.5*scale, pw-4*scale, ph-15*scale);
  gfx_r=0.2; gfx_g=0.2; gfx_b=0.2; gfx_a=1.0; gfx_roundrect(px, py, pw, ph, 14*scale, 1); gfx_roundrect(px, py, pw, ph, 14*scale, 0);
);

bg_pad_x = 25 * scale; bg_pad_y = 25 * scale;
bg_x = th_x - bg_pad_x + 7.5*scale; bg_y = disp_y - bg_pad_y; bg_w = (mk_x + th_w + bg_pad_x) - bg_x - 7.5*scale; bg_h = (sy3 + 1 * scale + bg_pad_y) - bg_y; 
draw_dark_panel(bg_x, bg_y, bg_w, bg_h);
bgd_x = dr_x - bg_pad_x + 7.5*scale; bgd_w = (wt_x + th_w + bg_pad_x) - bgd_x - 7.5*scale; bgd_h = (sy3 - 90 * scale + bg_pad_y) - bg_y; 
draw_dark_panel(bgd_x, bg_y, bgd_w, bgd_h);

function draw_tight_range(x, y, w, h, val1, val2, r_col, g_col, b_col, is_active) local(norm1, norm2, px1, px2, rad) (
  rad = 5 * scale; gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=1.0; gfx_roundrect(x, y + h/2 - 8*scale, w, 6*scale, 2*scale, 3);
  gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=0.5; gfx_rect(x, y + h/2 - 8*scale, w, 8*scale, 2*scale, 1);
  norm1 = log_map(max(val1, 20), 20, 20000); norm2 = log_map(max(val2, 20), 20, 20000);
  px1 = x + (norm1 * w); px2 = x + (norm2 * w);
  is_active ? ( gfx_r=r_col; gfx_g=g_col; gfx_b=b_col; gfx_a=0.7; ) : ( gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=0.3; );
  px2 > px1 ? gfx_rect(px1, y + h/2 - 8*scale, px2 - px1, 8*scale);
  is_active ? ( gfx_r=0.7; gfx_g=0.7; gfx_b=0.7; gfx_a=1.0; ) : ( gfx_r=0.4; gfx_g=0.4; gfx_b=0.4; gfx_a=0.8; );
  gfx_circle(px1, y + h/5, rad, 1, 1); gfx_circle(px2, y + h/5, rad, 1, 1);
  gfx_r=0.2; gfx_g=0.2; gfx_b=0.2; gfx_circle(px1, y + h/5, rad, 0, 1); gfx_circle(px2, y + h/5, rad, 0, 1);
);

function draw_sat_curve(x, y, size, foo, type, col_r, col_g, col_b, drv_val, wet_val, id, mod_env, is_active) local(px, last_px, py, last_py, norm_x, scr_x, scr_y, t, base_intensity, audio_mod, intensity, max_alpha, xx, n, flame_shape, c_bias, flame_h, num_dust, d_i, t_dust, rand_x, rand_y, speed_v, raw_y, norm_y, dy, raw_x, dx, fade, p_size, dust_ptr, vert_fade, bottom_fade, size_mod, speed_rnd, surge, rand_size_seed, is_big, v, th, ix, iy, isize) (
  p_size = max(1, ceil(((dy / size_mod) ^ 1.5) * (1.0 + is_big * (0.5 + intensity * 1.0)) * scale));
  gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1.0; gfx_roundrect(x, y, size, size, 8*scale, 1);
  t = time_precise() * 8.0 + (id * 2.37); 
  base_intensity = is_active ? drv_val / 100.0 : 0.0; audio_mod = 0.5 + (min(mod_env, 1.0) * 1.5); 
  intensity = clamp(base_intensity * audio_mod, 0.0, 1.0); max_alpha = is_active ? max(0.05, clamp((wet_val / 100.0) * audio_mod, 0.0, 1.0)) : 0.0;
  
  ix = floor(x); iy = floor(y); isize = floor(size);

  intensity > 0.01 ? (
    px = 2; 
    loop(isize - 4,
      xx = px / scale; n = sin(xx*0.11 - t) + sin(xx*0.29 + t*1.3)*0.6 + sin(xx*0.67 - t*0.9 + sin(xx*0.1))*0.4 + sin(xx*1.13 + t*1.7)*0.2;
      n = (n + 2.2) / 4.4; flame_shape = n ^ 3.5; c_bias = sin((px / (isize-4)) * $pi);
      flame_h = floor(min((flame_shape * intensity * (isize * 0.9) * c_bias) + (intensity * 6 * scale), isize - 4)); 
      
      gfx_r = col_r; gfx_g = col_g; gfx_b = col_b; gfx_a = max_alpha * 0.5; 
      gfx_rect(ix + px, iy + isize - 1 - flame_h, 1, flame_h);
      
      gfx_r = min(col_r+0.4, 1.0); gfx_g = min(col_g+0.4, 1.0); gfx_b = min(col_b+0.4, 1.0); gfx_a = max_alpha * 0.9;
      gfx_rect(ix + px, iy + isize - 1 - floor(flame_h * 0.45), 1, floor(flame_h * 0.45)); 
      
      px += 1;
    );
  );

  dust_ptr = 3100 + id; dust_ptr[] += 0.5 + (intensity ^ 1.5) * 4.0; t_dust = dust_ptr[];
  num_dust = 400; gfx_r = min(col_r + 0.15, 1.0); gfx_g = min(col_g + 0.15, 1.0); gfx_b = min(col_b + 0.15, 1.0); d_i = 1; size_mod = isize - floor(6*scale); 
  loop(num_dust,
    d_i / num_dust <= (intensity + 0.02) ? (
      rand_x = (d_i + id * 43.0) * 137.508; rand_y = (d_i + id * 29.0) * 83.921; 
      speed_rnd = rand_y * 11.0; speed_rnd = speed_rnd - floor(speed_rnd); 
      speed_v = (0.1 + (speed_rnd ^ 3.0) * 6.0) * scale;
      surge = sin(t_dust * 0.04 + d_i * 13.0) * (6.0 * scale); 
      raw_y = t_dust * speed_v + (rand_y * scale) + surge; 
      norm_y = raw_y - floor(raw_y / size_mod) * size_mod; dy = size_mod - norm_y; 
      raw_x = (rand_x * scale) + sin(t_dust * (0.01 + speed_rnd * 0.04) + d_i) * ((8.0 + speed_rnd * 18.0) * scale); 
      dx = raw_x - floor(raw_x / size_mod) * size_mod;
      fade = (dy / size_mod) * min((size_mod - dy) / (12 * scale), 1.0); gfx_a = min(max_alpha * fade * (0.5 + (rand_x - floor(rand_x))*0.5) * 5.0, 1.0); 
      rand_size_seed = (rand_x * 3.14159) - floor(rand_x * 3.14159); is_big = rand_size_seed < (0.05 + intensity * 0.45) ? 1.0 : 0.0;
      p_size = max(1, ceil(((dy / size_mod) ^ 1.5) * (1.0 + is_big * (0.5 + intensity * 1.0)) * scale));
      gfx_rect(floor(ix + 1.5*scale + dx), floor(iy + 1.5*scale + dy), floor(p_size), floor(p_size));
    ); d_i += 1;
  );

  gfx_r=0.35; gfx_g=0.35; gfx_b=0.35; gfx_a=1.0; gfx_roundrect(x, y, size, size, 8*scale, 0);
  gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=0.5; gfx_line(x, y + size/2, x + size, y + size/2); gfx_line(x + size/2, y, x + size/2, y + size); 
  is_active ? ( gfx_r=col_r; gfx_g=col_g; gfx_b=col_b; gfx_a=1.0; ) : ( gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=0.5; );
 px = 0;
   loop(isize,
     norm_x = (px / (isize-1)) * 2.0 - 1.0; 
     type == 0 ? ( py = norm_x > 0 ? (1+foo)*norm_x/(1+foo*abs(norm_x)) : (1+foo*0.2)*norm_x/(1+foo*0.2*abs(norm_x)); ) :
     type == 1 ? ( py = (1+foo)*norm_x/(1+foo*abs(norm_x)); ) : 
     type == 2 ? ( py = (1+(foo*2.5))*norm_x/(1+(foo*2.5)*abs(norm_x)); ) :
     type == 3 ? ( v = norm_x * (1 + foo * 2.5); py = abs(v) < 1 ? v - (v*v*v)/3 : sign(v) * (2/3); py *= 1.5; ) :
     type == 4 ? ( v = norm_x * (1 + foo * 4.0); py = max(min(v, 1.0), -1.0); ) :
     type == 5 ? ( v = norm_x * (1 + foo * 3.0); py = sin(v * 1.5707963); ) :
     type == 6 ? ( 
           // ASYMMETRICAL VISUALIZER
           th = 0.3; v = norm_x * (1 + foo * 2.2); 
           py = v > th ? (th + (1 - th) * tanh((v - th) / (1 - th))) : max(v, -1.0); 
         ) :
     ( th = 0.7; v = norm_x * (1 + foo * 2.2); py = abs(v) <= th ? v : sign(v) * (th + (1 - th) * tanh((abs(v) - th) / (1 - th))); );

     scr_y = iy + isize - ((py + 1.0) * 0.5 * isize); scr_x = ix + px;
     px > 0 ? ( gfx_line(last_px, last_py, scr_x, scr_y, 1); gfx_line(last_px, last_py+0.5*scale, scr_x, scr_y+0.5*scale, 1); );
     last_px = scr_x; last_py = scr_y; px += 1;
   );
 );

function draw_v_slider(x, y, w, h, val, display_val, name, is_grey, is_ratio, col_r, col_g, col_b, show_nums) (
  rad = 6 * scale; gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
  gfx_rect(x+rad, y, w-rad*2, h); gfx_rect(x, y+rad, w, h-rad*2);
  gfx_circle(x+rad, y+rad, rad, 1, 1); gfx_circle(x+w-rad, y+rad, rad, 1, 1); gfx_circle(x+rad, y+h-rad, rad, 1, 1); gfx_circle(x+w-rad, y+h-rad, rad, 1, 1);
  is_ratio == 1 ? ( norm = log(val * 97 - 96) / (2 * log(98)); norm = 1.0 - norm; ) : ( norm = (val) / 100; ); norm = clamp(norm, 0, 1); 
  pad = 2 * scale; fill_max = h - pad*2; fill_h = norm * fill_max; fill_y = y + h - pad - fill_h; fill_w = w - pad*2; fill_x = x + pad; f_rad = rad - pad;
  is_grey ? (gfx_r=col_r*0.3; gfx_g=col_g*0.3; gfx_b=col_b*0.3; gfx_a=0.8;) : (gfx_r=col_r; gfx_g=col_g; gfx_b=col_b; gfx_a=0.3);
  fill_h > 0 ? ( fill_h > f_rad ? gfx_rect(fill_x, fill_y, fill_w+1.5*scale, fill_h-f_rad + 5*scale) : gfx_rect(fill_x, fill_y, fill_w, fill_h); );
  gfx_r=col_r; gfx_g=col_g; gfx_b=col_b; gfx_a=0.9;
  gfx_roundrect(x, y, w, h, rad, 1); gfx_roundrect(x+0.5*scale, y+0.5*scale, w-1*scale, h-1*scale, rad-0.5*scale, 1); gfx_roundrect(x, y, w, h, rad, 1); gfx_roundrect(x+1*scale, y+1*scale, w-2*scale, h-2*scale, rad-1*scale, 1); 
  gfx_setfont(1, "Arial", 14 * scale); is_grey ? (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;) : (gfx_r=col_r; gfx_g=col_g; gfx_b=col_b;);
  gfx_measurestr(name, tw, th); gfx_x = x + (w-tw)/2; gfx_y = y + h + (8*scale); gfx_drawstr(name);
  show_nums == 1 ? (
    sprintf(#valstr, "%.1f", display_val); gfx_measurestr(#valstr, v_tw, v_th); gfx_x = x + (w-v_tw)/2; gfx_y = y - (18*scale); 
    is_grey ? (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;) : (gfx_r=0.6; gfx_g=0.6; gfx_b=0.6;); gfx_drawstr(#valstr);
  );
);

function draw_h_slider(x, y, w, h, val, min_v, max_v, name, unitstr, r_col, g_col, b_col, tr, tg, tb, is_log) (
  rad = 6 * scale; 
  norm = is_log == 1 ? log_map(max(val, min_v), min_v, max_v) : clamp((val - min_v) / (max_v - min_v), 0, 1); 
  pad = 2 * scale; fill_max = w - pad*2; fill_w = norm * fill_max; fill_y = y + pad; fill_x = x + pad; fill_h = h - pad*2; f_rad = rad - pad;
  gfx_r=r_col; gfx_g=g_col; gfx_b=b_col; gfx_a=1.0;
  fill_w > 0 ? ( fill_w > f_rad ? gfx_rect(fill_x-0.5*scale, fill_y-0.5*scale, fill_w+2.5*scale, fill_h+2.5*scale) : gfx_rect(fill_x, fill_y, fill_w, fill_h); );
  gfx_r=tr; gfx_g=tg; gfx_b=tb; gfx_a=0.8; gfx_roundrect(x, y, w, h, rad, 1); gfx_roundrect(x+0.5*scale, y+0.5*scale, w-1*scale, h-1*scale, rad-0.5*scale, 1);
  gfx_r=tr; gfx_g=tg; gfx_b=tb; 
  val < 1.0 ? sprintf(#valstr, "%s: %.2f %s", name, val, unitstr) : val < 100.0 ? sprintf(#valstr, "%s: %.1f %s", name, val, unitstr) : sprintf(#valstr, "%s: %.0f %s", name, val, unitstr);
  gfx_measurestr(#valstr, tw, th); gfx_x = x + (w-tw)/2; gfx_y = y + (h/2) - (th/2); gfx_drawstr(#valstr);
);

function draw_dual_h_slider(x, y, w, h, val1, val2, name, r_col, g_col, b_col) local(rad, norm1, norm2, pad, fill_x, fill_w, fill_y, fill_h, hx1, hx2) (
  rad = 6 * scale;
  norm1 = log_map(max(val1, 20), 20, 20000); norm2 = log_map(max(val2, 20), 20, 20000); pad = 2 * scale;
  fill_x = x + pad + (norm1 * (w - pad*2)); fill_w = (norm2 - norm1) * (w - pad*2); fill_y = y + pad; fill_h = h - pad*2;
  fill_w > 0 ? ( gfx_r=r_col; gfx_g=g_col; gfx_b=b_col; gfx_a=0.5; gfx_rect(fill_x-0.5*scale, fill_y-1*scale, fill_w, fill_h+3*scale); );
  hx1 = x + pad + (norm1 * (w - pad*2)); gfx_r=0.8; gfx_g=0.8; gfx_b=0.8; gfx_a=1.0; gfx_rect(hx1 - 2*scale, y+2, 4*scale, h);
  hx2 = x + pad + (norm2 * (w - pad*2)); gfx_rect(hx2 - 2*scale, y+2, 4*scale, h);
  gfx_r=r_col; gfx_g=g_col; gfx_b=b_col; gfx_a=1.0; gfx_roundrect(x, y, w, h, rad, 1); gfx_roundrect(x+0.5*scale, y+0.5*scale, w-1*scale, h-1*scale, rad-0.5*scale, 1);
  gfx_r=min(r_col+0.4, 1.0); gfx_g=min(g_col+0.4, 1.0); gfx_b=min(b_col+0.4, 1.0); sprintf(#valstr, "%s: %.0f Hz - %.0f Hz", name, val1, val2); 
  gfx_measurestr(#valstr, tw, th); gfx_x = x + (w-tw)/2; gfx_y = y + (h/2) - (th/2); gfx_drawstr(#valstr);
);

function draw_comp_strip(name, label_x, x, y, w, min_v, max_v, s_min, s_max, r, g, b, draw_lbl) local(pad, s_w, s_x, n1, n2, px1, px2, sw) (
  draw_lbl ? ( gfx_r=r; gfx_g=g; gfx_b=b; gfx_a=1.0; gfx_setfont(1, "Arial", 14 * scale, 'b'); gfx_measurestr(name, tw, th); gfx_x = label_x - tw; gfx_y = y - th/2; gfx_drawstr(name); );
  pad = 2 * scale; s_w = w - pad*2; s_x = x + pad; n1 = log_map(clamp(min_v, s_min, s_max), s_min, s_max); n2 = log_map(clamp(max_v, s_min, s_max), s_min, s_max);
  px1 = s_x + (n1 * s_w); px2 = s_x + (n2 * s_w); sw = max(px2 - px1, 4 * scale); 
  gfx_r=r; gfx_g=g; gfx_b=b; gfx_a=0.5; gfx_roundrect(px1, y - (2*scale), sw, 4*scale, 2*scale, 0); 
   gfx_r=r; gfx_g=g; gfx_b=b; gfx_a=0.2;
  gfx_rect(px1+0.5*scale, y - (1*scale), sw, 4*scale, 2*scale, 0); 
);

function draw_sat_mode_btn(bx, by, bw, bh, mode, is_active) local(rad, tw, th) (
  rad = 6 * scale; gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1;
  gfx_rect(bx+rad, by, bw-rad*2, bh); gfx_rect(bx, by+rad, bw, bh-rad*2); gfx_circle(bx+rad, by+rad, rad, 1, 1); 
  gfx_circle(bx+bw-rad, by+rad, rad, 1, 1); gfx_circle(bx+rad, by+bh-rad, rad, 1, 1); gfx_circle(bx+bw-rad, by+bh-rad, rad, 1, 1);
  is_active ? ( mode == 1 ? (gfx_r=0.8; gfx_g=0.2; gfx_b=0.5;) : (gfx_r=0.35; gfx_g=0.35; gfx_b=0.35;); gfx_a=1.0; ) : ( gfx_r=0.25; gfx_g=0.25; gfx_b=0.25; gfx_a=0.5; );
  gfx_roundrect(bx, by, bw, bh, rad, 1);
  is_active ? ( mode == 1 ? (gfx_r=0.8; gfx_g=0.2; gfx_b=0.5;) : (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;); ) : ( gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; );
  gfx_setfont(1, "Arial", 14 * scale); mode == 1 ? gfx_measurestr("MODE: PARALLEL", tw, th) : gfx_measurestr("MODE: SERIES", tw, th);
  gfx_x = bx + (bw-tw)/2; gfx_y = by + (5*scale); mode == 1 ? gfx_drawstr("MODE: PARALLEL") : gfx_drawstr("MODE: SERIES");
);

function draw_power_btn(px, py, size, is_on) local(rad) (
  rad = 4 * scale; gfx_r=0.15; gfx_g=0.15; gfx_b=0.15; gfx_a=1.0; gfx_roundrect(px, py, size, size, rad, 1);
  is_on ? (gfx_r=0.8; gfx_g=0.2; gfx_b=0.2;) : (gfx_r=0.3; gfx_g=0.3; gfx_b=0.3;);
  gfx_roundrect(px+2*scale, py+2*scale, size-4*scale, size-4*scale, rad-0.5*scale, 1);
  gfx_rect(px+6*scale, py+6*scale, size-10*scale, size-10*scale, rad-0.5*scale, 1);
);

function draw_sat_module(sx, sy, drv_val, wet_val, hp_v, lp_v, foo, type, id, mod_env, is_active) local(name, col_r, col_g, col_b, tw, th, lbl_x, tri_x, tri_y) (
  type == 0 ? ( name = "TUBE"; col_r = 1.0; col_g = 0.5; col_b = 0.1; ) :
  type == 1 ? ( name = "VCA"; col_r = 0.9; col_g = 0.2; col_b = 0.6; ) : 
  type == 2 ? ( name = "FET"; col_r = 0.6; col_g = 0.9; col_b = 0.2; ) :
  type == 3 ? ( name = "S CLIP"; col_r = 1.0; col_g = 0.85; col_b = 0.1; ) :
  type == 4 ? ( name = "H CLIP"; col_r = 0.95; col_g = 0.15; col_b = 0.15; ) :
  type == 5 ? ( name = "FOLD B"; col_r = 0.1; col_g = 0.85; col_b = 0.95; ) :
  type == 6 ? ( name = "  DIOD G"; col_r = 0.85; col_g = 0.55; col_b = 0.25; ) :
  ( name = "  DIOD S"; col_r = 0.25; col_g = 0.65; col_b = 0.95; );

  is_active ? ( gfx_r=col_r; gfx_g=col_g; gfx_b=col_b; gfx_a=0.5; ) : ( gfx_r=0.4; gfx_g=0.4; gfx_b=0.4; gfx_a=0.5; );
  gfx_setfont(1, "Arial", 16*scale, 'b'); gfx_measurestr(name, tw, th);
  lbl_x = sx + sat_sw - 36*scale + box_s/2 - tw/2; gfx_x = lbl_x; gfx_y = sy + 6*scale; gfx_drawstr(name);
  tri_x = lbl_x + tw + 6*scale; tri_y = sy + 12*scale;
  gfx_triangle(tri_x, tri_y, tri_x + 8*scale, tri_y, tri_x + 4*scale, tri_y + 4*scale);
  
  draw_v_slider(sx, sy, sat_sw, sat_sh, drv_val, drv_val, "DRIVE", is_active ? 0 : 1, 0, col_r, col_g, col_b, 1);
  draw_sat_curve(sx + sat_sw + 10*scale, sy, box_s, foo, type, col_r, col_g, col_b, drv_val, wet_val, id, mod_env, is_active);
  draw_v_slider(sx + sat_sw + 10*scale + box_s + 10*scale, sy, sat_sw, sat_sh, wet_val, wet_val, "WET", is_active ? 0 : 1, 0, col_r, col_g, col_b, 1);
  draw_tight_range(sx + sat_sw + 10*scale, sy + box_s + 10*scale, box_s, 16*scale, hp_v, lp_v, col_r, col_g, col_b, is_active);
);


// --- DRAW SATURATORS ---
draw_sat_module(pre_base_x, row1_y, pre_td, pre_tw, pt_hp, pt_lp, edit_target==2?pt_foo_R:pt_foo_L, pre_t1_type, 0, env_pt, pre_sat_on);
draw_sat_module(pre_base_x, row2_y, pre_vd, pre_vw, pv_hp, pv_lp, edit_target==2?pv_foo_R:pv_foo_L, pre_t2_type, 1, env_pv, pre_sat_on);
draw_sat_module(pre_base_x, row3_y, pre_fd, pre_fw, pf_hp, pf_lp, edit_target==2?pf_foo_R:pf_foo_L, pre_t3_type, 2, env_pf, pre_sat_on);

draw_sat_module(post_base_x, row1_y, post_td, post_tw, xt_hp, xt_lp, edit_target==2?xt_foo_R:xt_foo_L, post_t1_type, 3, env_xt, post_sat_on);
draw_sat_module(post_base_x, row2_y, post_vd, post_vw, xv_hp, xv_lp, edit_target==2?xv_foo_R:xv_foo_L, post_t2_type, 4, env_xv, post_sat_on);
draw_sat_module(post_base_x, row3_y, post_fd, post_fw, xf_hp, xf_lp, edit_target==2?xf_foo_R:xf_foo_L, post_t3_type, 5, env_xf, post_sat_on);


// --- DRAW COMPRESSOR & MIX FADERS ---
th_amp = 10 ^ (thresh / 20);
val_thresh_pct = sqrt(th_amp) * 100;
val_mk_pct = (makeup / 30) * 100;
draw_v_slider(th_x, disp_y, th_w, th_h, val_thresh_pct, thresh, "THRSH", 0, 0, 0.2, 0.6, 0.9, 1);
draw_v_slider(rt_x, disp_y, th_w, th_h, ratio, ratio, "RATIO", 0, 1, 0.2, 0.6, 0.9, 1);
