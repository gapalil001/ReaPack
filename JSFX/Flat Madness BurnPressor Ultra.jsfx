gfx_x = pre_lbl_x; gfx_y = lbl_y; 
pre_sat_on ? (gfx_r=0.8; gfx_g=0.2; gfx_b=0.2; gfx_a=1.0;) : (gfx_r=0.4; gfx_g=0.4; gfx_b=0.4; gfx_a=1.0;); gfx_drawstr("PRE DRIVE");
