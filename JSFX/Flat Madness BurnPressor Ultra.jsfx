desc: BurnPressor Ultra (Flat Madness)
// @version 1.0
// @author Dmytro Hapochka
// @link https://github.com/gapalil001/ReaPack
// @changelog Initial ReaPack release; processing code and parameters preserved.
// @provides
//   Flat Madness BurnPressor Ultra.jsfx > ../Flat Madness BurnPressor Ultra.jsfx

options: no_meter
// Tags: dynamics, compressor, saturation

// Define 8 inputs to support multiple sidechain routing options
in_pin:Main L
in_pin:Main R
in_pin:Aux 1 L (3)
in_pin:Aux 1 R (4)
in_pin:Aux 2 L (5)
in_pin:Aux 2 R (6)
in_pin:Aux 3 L (7)
in_pin:Aux 3 R (8)
out_pin:Main L
out_pin:Main R

slider1:thresh=0<-30,0,0.1>-Threshold (dB)
slider2:ratio=4<1.0,100,0.1>-Ratio (:1)
slider3:att=20<0.01,500,0.01>-Attack (ms)
slider4:rel=100<0.1,10000,0.1>-Release (ms)
slider5:schp=150<0,20000,1>-Sidechain HP (Hz)
slider6:sclp=20000<0,20000,1>-Sidechain LP (Hz) 
slider7:knee=0<0,24,0.1>-Knee Size (dB)
slider8:dry_pct=0<0,100,1>-Dry (%)
slider9:wet_pct=100<0,100,1>-Wet (%)
slider10:link_btn=0<0,1,1>-Link Dry/Wet
slider11:makeup=0<0,30,0.1>-Makeup (dB)
slider12:sc_ch=0<0,3,1{Main 1/2,Aux 3/4,Aux 5/6,Aux 7/8}>-SC Source

// PRE SATURATORS 
slider13:pre_td=0<0,100,0.1>-Pre 1 Drive (%)
slider14:pre_tw=100<0,100,0.1>-Pre 1 Wet (%)
slider15:pre_vd=0<0,100,0.1>-Pre 2 Drive (%)
slider16:pre_vw=100<0,100,0.1>-Pre 2 Wet (%)
slider17:pre_fd=0<0,100,0.1>-Pre 3 Drive (%)
slider18:pre_fw=100<0,100,0.1>-Pre 3 Wet (%)

// POST SATURATORS 
slider19:post_td=0<0,100,0.1>-Post 1 Drive (%)
slider20:post_tw=100<0,100,0.1>-Post 1 Wet (%)
slider21:post_vd=0<0,100,0.1>-Post 2 Drive (%)
slider22:post_vw=100<0,100,0.1>-Post 2 Wet (%)
slider23:post_fd=0<0,100,0.1>-Post 3 Drive (%)
slider24:post_fw=100<0,100,0.1>-Post 3 Wet (%)

// INDEPENDENT SATURATION ROUTING & IO
slider25:pre_sat_mode=1<0,1,1{Series,Parallel}>-Pre Sat Routing
slider26:post_sat_mode=1<0,1,1{Series,Parallel}>-Post Sat Routing
slider27:in_gain=0<-60,15,0.1>-Input (dB)
slider28:out_gain=0<-60,15,0.1>-Output (dB)

// PRE RANGES
slider29:pt_hp=20<20,20000,1>-Pre 1 HP
slider30:pt_lp=20000<20,20000,1>-Pre 1 LP
slider31:pv_hp=20<20,20000,1>-Pre 2 HP
slider32:pv_lp=20000<20,20000,1>-Pre 2 LP
slider33:pf_hp=20<20,20000,1>-Pre 3 HP
slider34:pf_lp=20000<20,20000,1>-Pre 3 LP

// POST RANGES
slider35:xt_hp=20<20,20000,1>-Post 1 HP
slider36:xt_lp=20000<20,20000,1>-Post 1 LP
slider37:xv_hp=20<20,20000,1>-Post 2 HP
slider38:xv_lp=20000<20,20000,1>-Post 2 HP
slider39:xf_hp=20<20,20000,1>-Post 3 HP
slider40:xf_lp=20000<20,20000,1>-Post 3 LP

// STAGE BYPASS & GLOBALS
slider41:pre_sat_on=1<0,1,1>-Pre Saturation On
slider42:post_sat_on=1<0,1,1>-Post Saturation On
slider49:clipper_on=1<0,1,1>-Output Clipper

// TYPE SELECTORS
slider43:pre_t1_type=0<0,7,1{Tube,VCA,FET,Soft Clip,Hard Clip,Foldback,Diode Ge,Diode Si}>-Pre 1 Type
slider44:pre_t2_type=1<0,7,1{Tube,VCA,FET,Soft Clip,Hard Clip,Foldback,Diode Ge,Diode Si}>-Pre 2 Type
slider45:pre_t3_type=2<0,7,1{Tube,VCA,FET,Soft Clip,Hard Clip,Foldback,Diode Ge,Diode Si}>-Pre 3 Type
slider46:post_t1_type=0<0,7,1{Tube,VCA,FET,Soft Clip,Hard Clip,Foldback,Diode Ge,Diode Si}>-Post 1 Type
slider47:post_t2_type=1<0,7,1{Tube,VCA,FET,Soft Clip,Hard Clip,Foldback,Diode Ge,Diode Si}>-Post 2 Type
slider48:post_t3_type=2<0,7,1{Tube,VCA,FET,Soft Clip,Hard Clip,Foldback,Diode Ge,Diode Si}>-Post 3 Type

// L/R & M/S ENGINE
slider50:stereo_mode=0<0,1,1{Left/Right,Mid/Side}>-Stereo Mode
slider51:edit_target=1<0,2,1{Left/Mid,Linked,Right/Side}>-Edit Target


@init
gfx_ext_retina = 1; 
ext_noinit = 1; // Prevent Reaper from clearing memory on playback/bypass stops
gfx_aud_env = 0; 
last_click_time = 0; last_mc = 0;

// Clipper Trackers
clip_env_db = 0; 
clip_peak_db = 0; 
disp_clip_peak = 0; 
last_clip_time = 0;

function tanh(x) local(e_minus_2x) (
  e_minus_2x = exp(-2 * x);
  (1 - e_minus_2x) / (1 + e_minus_2x);
);

env_pt = 0; env_pv = 0; env_pf = 0;
env_xt = 0; env_xv = 0; env_xf = 0;

// Dual-Mono Memory Banks
mem_L = 10000; mem_R = 10100; last_sliders = 10200;

// Initialize hard defaults ONLY if memory is completely empty 
mem_L[1] == 0 ? (
  mem_L[0]=0; mem_L[1]=4; mem_L[2]=20; mem_L[3]=100; mem_L[4]=150; mem_L[5]=20000; mem_L[6]=0; mem_L[7]=0;
  mem_L[8]=0; mem_L[9]=100; mem_L[10]=0; mem_L[11]=100; mem_L[12]=0; mem_L[13]=100;
  mem_L[14]=0; mem_L[15]=100; mem_L[16]=0; mem_L[17]=100; mem_L[18]=0; mem_L[19]=100;
  mem_L[20]=20; mem_L[21]=20000; mem_L[22]=20; mem_L[23]=20000; mem_L[24]=20; mem_L[25]=20000;
  mem_L[26]=20; mem_L[27]=20000; mem_L[28]=20; mem_L[29]=20000; mem_L[30]=20; mem_L[31]=20000;
  mem_L[32]=0; mem_L[33]=1; mem_L[34]=2; mem_L[35]=0; mem_L[36]=1; mem_L[37]=2;
  i=0; loop(38, mem_R[i]=mem_L[i]; i+=1;);
);

// Unified Biquad filters
function bq_hp(freq, q) instance(n0,n1,n2,d1,d2) local(w, alpha, cosw, a0) (
  w = 2 * $pi * max(freq, 10) / srate; alpha = sin(w) / (2 * q); cosw = cos(w); a0 = 1 + alpha;
  n0 = (1 + cosw) / 2 / a0; n1 = -(1 + cosw) / a0; n2 = (1 + cosw) / 2 / a0;
  d1 = -2 * cosw / a0; d2 = (1 - alpha) / a0;
);
function bq_lp(freq, q) instance(n0,n1,n2,d1,d2) local(w, alpha, cosw, a0) (
  w = 2 * $pi * min(freq, 20000) / srate; alpha = sin(w) / (2 * q); cosw = cos(w); a0 = 1 + alpha;
  n0 = (1 - cosw) / 2 / a0; n1 = (1 - cosw) / a0; n2 = (1 - cosw) / 2 / a0;
  d1 = -2 * cosw / a0; d2 = (1 - alpha) / a0;
);
function bq_run(in) instance(n0,n1,n2,d1,d2,z1,z2,out1,out2) local(out) (
  out = n0*in + n1*z1 + n2*z2 - d1*out1 - d2*out2;
  z2 = z1; z1 = in; out2 = out1; out1 = out; out;
);

// Linkwitz-Riley 4 (24dB/oct) Wrappers
function lr4_hp(freq) instance(f1, f2) (
  f1.bq_hp(freq, 0.7071);
  f2.bq_hp(freq, 0.7071);
);
function lr4_lp(freq) instance(f1, f2) (
  f1.bq_lp(freq, 0.7071);
  f2.bq_lp(freq, 0.7071);
);
function lr4_run(in) instance(f1, f2) (
  f2.bq_run(f1.bq_run(in));
);

function clamp(val, min_val, max_val) ( min(max(val, min_val), max_val); );

function sign(val) ( val > 0 ? 1 : val < 0 ? -1 : 0; );

function process_sat(in, type, foo) local(sat, v, th) (
  type == 0 ? ( sat = in > 0 ? (1+foo)*in/(1+foo*abs(in)) : (1+foo*0.2)*in/(1+foo*0.2*abs(in)); ) : 
  type == 1 ? ( sat = (1+foo)*in/(1+foo*abs(in)); ) : 
  type == 2 ? ( sat = (1+(foo*2.5))*in/(1+(foo*2.5)*abs(in)); ) :
  type == 3 ? ( v = in * (1 + foo * 2.5); sat = abs(v) < 1 ? v - (v*v*v)/3 : sign(v) * (2/3); sat *= 1.5; ) :
  type == 4 ? ( v = in * (1 + foo * 4.0); sat = max(min(v, 1.0), -1.0); ) :
  type == 5 ? ( v = in * (1 + foo * 3.0); sat = sin(v * 1.5707963); ) :
  type == 6 ? ( 
      // ASYMMETRICAL Diode Germanium (0.3v knee)
      th = 0.3; v = in * (1 + foo * 2.2);
      sat = v > th ? (th + (1 - th) * tanh((v - th) / (1 - th))) : max(v, -1.0);
    ) : ( 
    // SYMMETRICAL Diode Silicon (0.7v knee)
    th = 0.7; v = in * (1 + foo * 2.2);
    sat = abs(v) <= th ? v : sign(v) * (th + (1 - th) * tanh((abs(v) - th) / (1 - th)));
  );
  sat;
);

MAX_POINTS = 640; TIME_FRAME_SEC = 2.0;
wave_buf = 0; in_wave_buf = 1000; diff_buf = 2000;        
s_count = 0; write_pos = 0; max_in = 0; max_out = 0; min_gr = 1;
peak_env_L = 0; smooth_env_L = 0; peak_env_R = 0; smooth_env_R = 0; 
show_grid = 1; grid_v = 3000; 
grid_v[0] = -1; grid_v[1] = -2; grid_v[2] = -3; grid_v[3] = -4; grid_v[4] = -5;
grid_v[5] = -6; grid_v[6] = -12; grid_v[7] = -18; grid_v[8] = -24; 
num_grid = 9; db2log = 0.11512925464970228420089957273422; 


@serialize
// Save independent channel memory blocks into project file
file_mem(0, mem_L, 38);
file_mem(0, mem_R, 38);


@block
// --- DYNAMIC SRATE CHECK FOR VISUALIZER SPEED ---
srate > 0 ? samples_per_pixel = floor(srate / (MAX_POINTS / TIME_FRAME_SEC)) : samples_per_pixel = 137;

// --- SYNC GUI TO MEMORY ARRAYS ---
function sync_mem(s_val, idx) (
  last_sliders[idx] != s_val ? (
    edit_target == 1 ? ( mem_L[idx] = s_val; mem_R[idx] = s_val; ) :
    edit_target == 0 ? ( mem_L[idx] = s_val; ) : ( mem_R[idx] = s_val; );
    last_sliders[idx] = s_val;
  );
);
sync_mem(slider1,0); sync_mem(slider2,1); sync_mem(slider3,2); sync_mem(slider4,3); sync_mem(slider5,4); sync_mem(slider6,5); sync_mem(slider7,6); sync_mem(slider11,7);
sync_mem(slider13,8); sync_mem(slider14,9); sync_mem(slider15,10); sync_mem(slider16,11); sync_mem(slider17,12); sync_mem(slider18,13);
sync_mem(slider19,14); sync_mem(slider20,15); sync_mem(slider21,16); sync_mem(slider22,17); sync_mem(slider23,18); sync_mem(slider24,19);
sync_mem(slider29,20); sync_mem(slider30,21); sync_mem(slider31,22); sync_mem(slider32,23); sync_mem(slider33,24); sync_mem(slider34,25);
sync_mem(slider35,26); sync_mem(slider36,27); sync_mem(slider37,28); sync_mem(slider38,29); sync_mem(slider39,30); sync_mem(slider40,31);
sync_mem(slider43,32); sync_mem(slider44,33); sync_mem(slider45,34); sync_mem(slider46,35); sync_mem(slider47,36); sync_mem(slider48,37);

// --- INDEPENDENT DSP SETUP ---
sc_hp1_L.bq_hp(max(mem_L[4], 10), 0.7071); sc_hp2_L.bq_hp(max(mem_L[4], 10), 0.7071); 
sc_lp1_L.bq_lp(min(mem_L[5], 20000), 0.7071); sc_lp2_L.bq_lp(min(mem_L[5], 20000), 0.7071);
sc_hp1_R.bq_hp(max(mem_R[4], 10), 0.7071); sc_hp2_R.bq_hp(max(mem_R[4], 10), 0.7071); 
sc_lp1_R.bq_lp(min(mem_R[5], 20000), 0.7071); sc_lp2_R.bq_lp(min(mem_R[5], 20000), 0.7071);

dry_gain = dry_pct / 100; wet_gain = wet_pct / 100;
att_coeff_L = exp(-1 / (srate * (mem_L[2] / 1000))); rel_coeff_L = exp(-1 / (srate * (mem_L[3] / 1000))); linear_makeup_L = 10 ^ (mem_L[7] / 20);
att_coeff_R = exp(-1 / (srate * (mem_R[2] / 1000))); rel_coeff_R = exp(-1 / (srate * (mem_R[3] / 1000))); linear_makeup_R = 10 ^ (mem_R[7] / 20);

in_gain <= -59.9 ? ig_lin = 0.0 : ig_lin = 10 ^ (in_gain / 20);
out_gain <= -59.9 ? og_lin = 0.0 : og_lin = 10 ^ (out_gain / 20);

function get_comp(drv_v, type) ( type == 2 ? 1.0 - (drv_v * 0.5) : 1.0 - (drv_v * 0.4); );

// Pre Sat L
pt_drv_v_L = min(mem_L[8]/100, 0.999); pt_foo_L = 2*pt_drv_v_L/(1-pt_drv_v_L); pt_wet_v_L = mem_L[9]/100; pt_comp_L = get_comp(pt_drv_v_L, mem_L[32]);
pv_drv_v_L = min(mem_L[10]/100, 0.999); pv_foo_L = 2*pv_drv_v_L/(1-pv_drv_v_L); pv_wet_v_L = mem_L[11]/100; pv_comp_L = get_comp(pv_drv_v_L, mem_L[33]);
pf_drv_v_L = min(mem_L[12]/100, 0.999); pf_foo_L = 2*pf_drv_v_L/(1-pf_drv_v_L); pf_wet_v_L = mem_L[13]/100; pf_comp_L = get_comp(pf_drv_v_L, mem_L[34]);

pt_hp_pass_L.lr4_hp(mem_L[20]); pt_hp_cut_L.lr4_lp(mem_L[20]); pt_lp_pass_L.lr4_lp(mem_L[21]); pt_lp_cut_L.lr4_hp(mem_L[21]);
pv_hp_pass_L.lr4_hp(mem_L[22]); pv_hp_cut_L.lr4_lp(mem_L[22]); pv_lp_pass_L.lr4_lp(mem_L[23]); pv_lp_cut_L.lr4_hp(mem_L[23]);
pf_hp_pass_L.lr4_hp(mem_L[24]); pf_hp_cut_L.lr4_lp(mem_L[24]); pf_lp_pass_L.lr4_lp(mem_L[25]); pf_lp_cut_L.lr4_hp(mem_L[25]);

// Pre Sat R
pt_drv_v_R = min(mem_R[8]/100, 0.999); pt_foo_R = 2*pt_drv_v_R/(1-pt_drv_v_R); pt_wet_v_R = mem_R[9]/100; pt_comp_R = get_comp(pt_drv_v_R, mem_R[32]);
pv_drv_v_R = min(mem_R[10]/100, 0.999); pv_foo_R = 2*pv_drv_v_R/(1-pv_drv_v_R); pv_wet_v_R = mem_R[11]/100; pv_comp_R = get_comp(pv_drv_v_R, mem_R[33]);
pf_drv_v_R = min(mem_R[12]/100, 0.999); pf_foo_R = 2*pf_drv_v_R/(1-pf_drv_v_R); pf_wet_v_R = mem_R[13]/100; pf_comp_R = get_comp(pf_drv_v_R, mem_R[34]);

pt_hp_pass_R.lr4_hp(mem_R[20]); pt_hp_cut_R.lr4_lp(mem_R[20]); pt_lp_pass_R.lr4_lp(mem_R[21]); pt_lp_cut_R.lr4_hp(mem_R[21]);
pv_hp_pass_R.lr4_hp(mem_R[22]); pv_hp_cut_R.lr4_lp(mem_R[22]); pv_lp_pass_R.lr4_lp(mem_R[23]); pv_lp_cut_R.lr4_hp(mem_R[23]);
pf_hp_pass_R.lr4_hp(mem_R[24]); pf_hp_cut_R.lr4_lp(mem_R[24]); pf_lp_pass_R.lr4_lp(mem_R[25]); pf_lp_cut_R.lr4_hp(mem_R[25]);

// Post Sat L
xt_drv_v_L = min(mem_L[14]/100, 0.999); xt_foo_L = 2*xt_drv_v_L/(1-xt_drv_v_L); xt_wet_v_L = mem_L[15]/100; xt_comp_L = get_comp(xt_drv_v_L, mem_L[35]);
xv_drv_v_L = min(mem_L[16]/100, 0.999); xv_foo_L = 2*xv_drv_v_L/(1-xv_drv_v_L); xv_wet_v_L = mem_L[17]/100; xv_comp_L = get_comp(xv_drv_v_L, mem_L[36]);
xf_drv_v_L = min(mem_L[18]/100, 0.999); xf_foo_L = 2*xf_drv_v_L/(1-xf_drv_v_L); xf_wet_v_L = mem_L[19]/100; xf_comp_L = get_comp(xf_drv_v_L, mem_L[37]);

xt_hp_pass_L.lr4_hp(mem_L[26]); xt_hp_cut_L.lr4_lp(mem_L[26]); xt_lp_pass_L.lr4_lp(mem_L[27]); xt_lp_cut_L.lr4_hp(mem_L[27]);
xv_hp_pass_L.lr4_hp(mem_L[28]); xv_hp_cut_L.lr4_lp(mem_L[28]); xv_lp_pass_L.lr4_lp(mem_L[29]); xv_lp_cut_L.lr4_hp(mem_L[29]);
xf_hp_pass_L.lr4_hp(mem_L[30]); xf_hp_cut_L.lr4_lp(mem_L[30]); xf_lp_pass_L.lr4_lp(mem_L[31]); xf_lp_cut_L.lr4_hp(mem_L[31]);

// Post Sat R
xt_drv_v_R = min(mem_R[14]/100, 0.999); xt_foo_R = 2*xt_drv_v_R/(1-xt_drv_v_R); xt_wet_v_R = mem_R[15]/100; xt_comp_R = get_comp(xt_drv_v_R, mem_R[35]);
xv_drv_v_R = min(mem_R[16]/100, 0.999); xv_foo_R = 2*xv_drv_v_R/(1-xv_drv_v_R); xv_wet_v_R = mem_R[17]/100; xv_comp_R = get_comp(xv_drv_v_R, mem_R[36]);
xf_drv_v_R = min(mem_R[18]/100, 0.999); xf_foo_R = 2*xf_drv_v_R/(1-xf_drv_v_R); xf_wet_v_R = mem_R[19]/100; xf_comp_R = get_comp(xf_drv_v_R, mem_R[37]);

xt_hp_pass_R.lr4_hp(mem_R[26]); xt_hp_cut_R.lr4_lp(mem_R[26]); xt_lp_pass_R.lr4_lp(mem_R[27]); xt_lp_cut_R.lr4_hp(mem_R[27]);
xv_hp_pass_R.lr4_hp(mem_R[28]); xv_hp_cut_R.lr4_lp(mem_R[28]); xv_lp_pass_R.lr4_lp(mem_R[29]); xv_lp_cut_R.lr4_hp(mem_R[29]);
xf_hp_pass_R.lr4_hp(mem_R[30]); xf_hp_cut_R.lr4_lp(mem_R[30]); xf_lp_pass_R.lr4_lp(mem_R[31]); xf_lp_cut_R.lr4_hp(mem_R[31]);

// Filter Bypasses
pt_filt_on_L = (mem_L[20] > 20 || mem_L[21] < 20000); pv_filt_on_L = (mem_L[22] > 20 || mem_L[23] < 20000); pf_filt_on_L = (mem_L[24] > 20 || mem_L[25] < 20000);
pt_filt_on_R = (mem_R[20] > 20 || mem_R[21] < 20000); pv_filt_on_R = (mem_R[22] > 20 || mem_R[23] < 20000); pf_filt_on_R = (mem_R[24] > 20 || mem_R[25] < 20000);
xt_filt_on_L = (mem_L[26] > 20 || mem_L[27] < 20000); xv_filt_on_L = (mem_L[28] > 20 || mem_L[29] < 20000); xf_filt_on_L = (mem_L[30] > 20 || mem_L[31] < 20000);
xt_filt_on_R = (mem_R[26] > 20 || mem_R[27] < 20000); xv_filt_on_R = (mem_R[28] > 20 || mem_R[29] < 20000); xf_filt_on_R = (mem_R[30] > 20 || mem_R[31] < 20000);


@sample
raw_in_L = spl0; raw_in_R = spl1;
in_L = spl0 * ig_lin; in_R = spl1 * ig_lin;

// Encode M/S Matrix
stereo_mode == 1 ? (
  ms_mid = (in_L + in_R) * 0.5; ms_side = (in_L - in_R) * 0.5;
  in_L = ms_mid; in_R = ms_side;
  raw_mid = (raw_in_L + raw_in_R) * 0.5; raw_side = (raw_in_L - raw_in_R) * 0.5;
  raw_in_L = raw_mid; raw_in_R = raw_side;
);

// --- STAGE 1: PRE-SATURATION ---
pre_sat_on == 1 ? (
  pre_sat_mode == 1 ? (
    // --- DELTA PARALLEL (3-Band Trees) ---
    // Pre 1 (Tube)
    pt_filt_on_L ? (
      pt_low_L = pt_hp_cut_L.lr4_run(in_L); pt_mh_L = pt_hp_pass_L.lr4_run(in_L);
      pt_mid_L = pt_lp_pass_L.lr4_run(pt_mh_L); pt_high_L = pt_lp_cut_L.lr4_run(pt_mh_L);
      pt_gap_L = pt_low_L + pt_high_L;
    ) : ( pt_gap_L = 0; pt_mid_L = in_L; );
    pt_filt_on_R ? (
      pt_low_R = pt_hp_cut_R.lr4_run(in_R); pt_mh_R = pt_hp_pass_R.lr4_run(in_R);
      pt_mid_R = pt_lp_pass_R.lr4_run(pt_mh_R); pt_high_R = pt_lp_cut_R.lr4_run(pt_mh_R);
      pt_gap_R = pt_low_R + pt_high_R;
    ) : ( pt_gap_R = 0; pt_mid_R = in_R; );
    t_sat_L = process_sat(pt_mid_L, mem_L[32], pt_foo_L) * pt_comp_L;
    t_sat_R = process_sat(pt_mid_R, mem_R[32], pt_foo_R) * pt_comp_R;

    // Pre 2 (VCA)
    pv_filt_on_L ? (
      pv_low_L = pv_hp_cut_L.lr4_run(in_L); pv_mh_L = pv_hp_pass_L.lr4_run(in_L);
      pv_mid_L = pv_lp_pass_L.lr4_run(pv_mh_L); pv_high_L = pv_lp_cut_L.lr4_run(pv_mh_L);
      pv_gap_L = pv_low_L + pv_high_L;
    ) : ( pv_gap_L = 0; pv_mid_L = in_L; );
    pv_filt_on_R ? (
      pv_low_R = pv_hp_cut_R.lr4_run(in_R); pv_mh_R = pv_hp_pass_R.lr4_run(in_R);
      pv_mid_R = pv_lp_pass_R.lr4_run(pv_mh_R); pv_high_R = pv_lp_cut_R.lr4_run(pv_mh_R);
      pv_gap_R = pv_low_R + pv_high_R;
    ) : ( pv_gap_R = 0; pv_mid_R = in_R; );
    v_sat_L = process_sat(pv_mid_L, mem_L[33], pv_foo_L) * pv_comp_L;
    v_sat_R = process_sat(pv_mid_R, mem_R[33], pv_foo_R) * pv_comp_R;

    // Pre 3 (FET)
    pf_filt_on_L ? (
      pf_low_L = pf_hp_cut_L.lr4_run(in_L); pf_mh_L = pf_hp_pass_L.lr4_run(in_L);
      pf_mid_L = pf_lp_pass_L.lr4_run(pf_mh_L); pf_high_L = pf_lp_cut_L.lr4_run(pf_mh_L);
      pf_gap_L = pf_low_L + pf_high_L;
    ) : ( pf_gap_L = 0; pf_mid_L = in_L; );
    pf_filt_on_R ? (
      pf_low_R = pf_hp_cut_R.lr4_run(in_R); pf_mh_R = pf_hp_pass_R.lr4_run(in_R);
      pf_mid_R = pf_lp_pass_R.lr4_run(pf_mh_R); pf_high_R = pf_lp_cut_R.lr4_run(pf_mh_R);
      pf_gap_R = pf_low_R + pf_high_R;
    ) : ( pf_gap_R = 0; pf_mid_R = in_R; );
    f_sat_L = process_sat(pf_mid_L, mem_L[34], pf_foo_L) * pf_comp_L;
    f_sat_R = process_sat(pf_mid_R, mem_R[34], pf_foo_R) * pf_comp_R;

    // Parallel Summation (adds only pure wet saturation delta to prevent multiplying gaps)
    in_L = in_L + ((t_sat_L - pt_mid_L) * pt_wet_v_L) + ((v_sat_L - pv_mid_L) * pv_wet_v_L) + ((f_sat_L - pf_mid_L) * pf_wet_v_L);
    in_R = in_R + ((t_sat_R - pt_mid_R) * pt_wet_v_R) + ((v_sat_R - pv_mid_R) * pv_wet_v_R) + ((f_sat_R - pf_mid_R) * pf_wet_v_R);
  ) : (
    // --- DELTA SERIES (3-Band Trees) ---
    // Pre 1 (Tube)
    pt_filt_on_L ? (
      pt_low_L = pt_hp_cut_L.lr4_run(in_L); pt_mh_L = pt_hp_pass_L.lr4_run(in_L);
      pt_mid_L = pt_lp_pass_L.lr4_run(pt_mh_L); pt_high_L = pt_lp_cut_L.lr4_run(pt_mh_L);
      pt_gap_L = pt_low_L + pt_high_L;
    ) : ( pt_gap_L = 0; pt_mid_L = in_L; );
    pt_filt_on_R ? (
      pt_low_R = pt_hp_cut_R.lr4_run(in_R); pt_mh_R = pt_hp_pass_R.lr4_run(in_R);
      pt_mid_R = pt_lp_pass_R.lr4_run(pt_mh_R); pt_high_R = pt_lp_cut_R.lr4_run(pt_mh_R);
      pt_gap_R = pt_low_R + pt_high_R;
    ) : ( pt_gap_R = 0; pt_mid_R = in_R; );
    t_sat_L = process_sat(pt_mid_L, mem_L[32], pt_foo_L) * pt_comp_L;
    t_sat_R = process_sat(pt_mid_R, mem_R[32], pt_foo_R) * pt_comp_R;
    in_L = pt_gap_L + (t_sat_L * pt_wet_v_L) + (pt_mid_L * (1.0 - pt_wet_v_L));
    in_R = pt_gap_R + (t_sat_R * pt_wet_v_R) + (pt_mid_R * (1.0 - pt_wet_v_R));

    // Pre 2 (VCA)
    pv_filt_on_L ? (
      pv_low_L = pv_hp_cut_L.lr4_run(in_L); pv_mh_L = pv_hp_pass_L.lr4_run(in_L);
      pv_mid_L = pv_lp_pass_L.lr4_run(pv_mh_L); pv_high_L = pv_lp_cut_L.lr4_run(pv_mh_L);
      pv_gap_L = pv_low_L + pv_high_L;
    ) : ( pv_gap_L = 0; pv_mid_L = in_L; );
    pv_filt_on_R ? (
      pv_low_R = pv_hp_cut_R.lr4_run(in_R); pv_mh_R = pv_hp_pass_R.lr4_run(in_R);
      pv_mid_R = pv_lp_pass_R.lr4_run(pv_mh_R); pv_high_R = pv_lp_cut_R.lr4_run(pv_mh_R);
      pv_gap_R = pv_low_R + pv_high_R;
    ) : ( pv_gap_R = 0; pv_mid_R = in_R; );
    v_sat_L = process_sat(pv_mid_L, mem_L[33], pv_foo_L) * pv_comp_L;
    v_sat_R = process_sat(pv_mid_R, mem_R[33], pv_foo_R) * pv_comp_R;
    in_L = pv_gap_L + (v_sat_L * pv_wet_v_L) + (pv_mid_L * (1.0 - pv_wet_v_L));
    in_R = pv_gap_R + (v_sat_R * pv_wet_v_R) + (pv_mid_R * (1.0 - pv_wet_v_R));

    // Pre 3 (FET)
    pf_filt_on_L ? (
      pf_low_L = pf_hp_cut_L.lr4_run(in_L); pf_mh_L = pf_hp_pass_L.lr4_run(in_L);
      pf_mid_L = pf_lp_pass_L.lr4_run(pf_mh_L); pf_high_L = pf_lp_cut_L.lr4_run(pf_mh_L);
      pf_gap_L = pf_low_L + pf_high_L;
    ) : ( pf_gap_L = 0; pf_mid_L = in_L; );
    pf_filt_on_R ? (
      pf_low_R = pf_hp_cut_R.lr4_run(in_R); pf_mh_R = pf_hp_pass_R.lr4_run(in_R);
      pf_mid_R = pf_lp_pass_R.lr4_run(pf_mh_R); pf_high_R = pf_lp_cut_R.lr4_run(pf_mh_R);
      pf_gap_R = pf_low_R + pf_high_R;
    ) : ( pf_gap_R = 0; pf_mid_R = in_R; );
    f_sat_L = process_sat(pf_mid_L, mem_L[34], pf_foo_L) * pf_comp_L;
    f_sat_R = process_sat(pf_mid_R, mem_R[34], pf_foo_R) * pf_comp_R;
    in_L = pf_gap_L + (f_sat_L * pf_wet_v_L) + (pf_mid_L * (1.0 - pf_wet_v_L));
    in_R = pf_gap_R + (f_sat_R * pf_wet_v_R) + (pf_mid_R * (1.0 - pf_wet_v_R));
  );

  p_pt = max(abs(t_sat_L), abs(t_sat_R)); p_pt > env_pt ? env_pt += (p_pt - env_pt)*0.1 : env_pt *= 0.99;
  p_pv = max(abs(v_sat_L), abs(v_sat_R)); p_pv > env_pv ? env_pv += (p_pv - env_pv)*0.1 : env_pv *= 0.99;
  p_pf = max(abs(f_sat_L), abs(f_sat_R)); p_pf > env_pf ? env_pf += (p_pf - env_pf)*0.1 : env_pf *= 0.99;
) : (
  env_pt *= 0.99; env_pv *= 0.99; env_pf *= 0.99;
);


// --- STAGE 2: DYNAMICS ---
sc_ch == 0 ? ( sc_sig_L = in_L; sc_sig_R = in_R; ) : 
sc_ch == 1 ? ( sc_sig_L = spl2; sc_sig_R = spl3; stereo_mode == 1 ? (sc_sig_L=(spl2+spl3)*0.5; sc_sig_R=(spl2-spl3)*0.5;) : 0; ) :
sc_ch == 2 ? ( sc_sig_L = spl4; sc_sig_R = spl5; stereo_mode == 1 ? (sc_sig_L=(spl4+spl5)*0.5; sc_sig_R=(spl4-spl5)*0.5;) : 0; ) :
             ( sc_sig_L = spl6; sc_sig_R = spl7; stereo_mode == 1 ? (sc_sig_L=(spl6+spl7)*0.5; sc_sig_R=(spl6-spl7)*0.5;) : 0; );

mem_L[4] > 5 ? ( sc_sig_L = sc_hp1_L.bq_run(sc_sig_L); sc_sig_L = sc_hp2_L.bq_run(sc_sig_L); );
mem_L[5] < 19900 ? ( sc_sig_L = sc_lp1_L.bq_run(sc_sig_L); sc_sig_L = sc_lp2_L.bq_run(sc_sig_L); );
mem_R[4] > 5 ? ( sc_sig_R = sc_hp1_R.bq_run(sc_sig_R); sc_sig_R = sc_hp2_R.bq_run(sc_sig_R); );
mem_R[5] < 19900 ? ( sc_sig_R = sc_lp1_R.bq_run(sc_sig_R); sc_sig_R = sc_lp2_R.bq_run(sc_sig_R); );

sc_abs_L = abs(sc_sig_L); sc_abs_R = abs(sc_sig_R);
edit_target == 1 ? ( sc_abs_L = max(sc_abs_L, sc_abs_R); sc_abs_R = sc_abs_L; ); // Link SC if editing Linked

sc_abs_L > peak_env_L ? peak_env_L = sc_abs_L : peak_env_L = peak_env_L * rel_coeff_L;
peak_env_L > smooth_env_L ? smooth_env_L = smooth_env_L * att_coeff_L + peak_env_L * (1.0 - att_coeff_L) : smooth_env_L = peak_env_L;
sc_abs_R > peak_env_R ? peak_env_R = sc_abs_R : peak_env_R = peak_env_R * rel_coeff_R;
peak_env_R > smooth_env_R ? smooth_env_R = smooth_env_R * att_coeff_R + peak_env_R * (1.0 - att_coeff_R) : smooth_env_R = peak_env_R;

level_db_L = 20 * log10(max(smooth_env_L, 0.00001));
diff_L = level_db_L - mem_L[0]; knee_half_L = mem_L[6] / 2; target_gr_L = 0;
diff_L < -knee_half_L ? target_gr_L = 0 : diff_L > knee_half_L ? target_gr_L = diff_L * (1 - 1/mem_L[1]) : target_gr_L = ((diff_L + knee_half_L)^2) / (2 * max(mem_L[6],0.001)) * (1 - 1/mem_L[1]);

level_db_R = 20 * log10(max(smooth_env_R, 0.00001));
diff_R = level_db_R - mem_R[0]; knee_half_R = mem_R[6] / 2; target_gr_R = 0;
diff_R < -knee_half_R ? target_gr_R = 0 : diff_R > knee_half_R ? target_gr_R = diff_R * (1 - 1/mem_R[1]) : target_gr_R = ((diff_R + knee_half_R)^2) / (2 * max(mem_R[6],0.001)) * (1 - 1/mem_R[1]);

linear_gr_L = 10 ^ (-target_gr_L / 20); comp_L = in_L * linear_gr_L * linear_makeup_L;
linear_gr_R = 10 ^ (-target_gr_R / 20); comp_R = in_R * linear_gr_R * linear_makeup_R;


// --- STAGE 3: POST-SATURATION ---
post_sat_on == 1 ? (
  post_sat_mode == 1 ? (
    // --- DELTA PARALLEL (3-Band Trees) ---
    // Post 1 (Tube)
    xt_filt_on_L ? (
      xt_low_L = xt_hp_cut_L.lr4_run(comp_L); xt_mh_L = xt_hp_pass_L.lr4_run(comp_L);
      xt_mid_L = xt_lp_pass_L.lr4_run(xt_mh_L); xt_high_L = xt_lp_cut_L.lr4_run(xt_mh_L);
      xt_gap_L = xt_low_L + xt_high_L;
    ) : ( xt_gap_L = 0; xt_mid_L = comp_L; );
    xt_filt_on_R ? (
      xt_low_R = xt_hp_cut_R.lr4_run(comp_R); xt_mh_R = xt_hp_pass_R.lr4_run(comp_R);
      xt_mid_R = xt_lp_pass_R.lr4_run(xt_mh_R); xt_high_R = xt_lp_cut_R.lr4_run(xt_mh_R);
      xt_gap_R = xt_low_R + xt_high_R;
    ) : ( xt_gap_R = 0; xt_mid_R = comp_R; );
    t_sat_L = process_sat(xt_mid_L, mem_L[35], xt_foo_L) * xt_comp_L;
    t_sat_R = process_sat(xt_mid_R, mem_R[35], xt_foo_R) * xt_comp_R;

    // Post 2 (VCA)
    xv_filt_on_L ? (
      xv_low_L = xv_hp_cut_L.lr4_run(comp_L); xv_mh_L = xv_hp_pass_L.lr4_run(comp_L);
      xv_mid_L = xv_lp_pass_L.lr4_run(xv_mh_L); xv_high_L = xv_lp_cut_L.lr4_run(xv_mh_L);
      xv_gap_L = xv_low_L + xv_high_L;
    ) : ( xv_gap_L = 0; xv_mid_L = comp_L; );
    xv_filt_on_R ? (
      xv_low_R = xv_hp_cut_R.lr4_run(comp_R); xv_mh_R = xv_hp_pass_R.lr4_run(comp_R);
      xv_mid_R = xv_lp_pass_R.lr4_run(xv_mh_R); xv_high_R = xv_lp_cut_R.lr4_run(xv_mh_R);
      xv_gap_R = xv_low_R + xv_high_R;
    ) : ( xv_gap_R = 0; xv_mid_R = comp_R; );
    v_sat_L = process_sat(xv_mid_L, mem_L[36], xv_foo_L) * xv_comp_L;
    v_sat_R = process_sat(xv_mid_R, mem_R[36], xv_foo_R) * xv_comp_R;

    // Post 3 (FET)
    xf_filt_on_L ? (
      xf_low_L = xf_hp_cut_L.lr4_run(comp_L); xf_mh_L = xf_hp_pass_L.lr4_run(comp_L);
      xf_mid_L = xf_lp_pass_L.lr4_run(xf_mh_L); xf_high_L = xf_lp_cut_L.lr4_run(xf_mh_L);
      xf_gap_L = xf_low_L + xf_high_L;
    ) : ( xf_gap_L = 0; xf_mid_L = comp_L; );
    xf_filt_on_R ? (
      xf_low_R = xf_hp_cut_R.lr4_run(comp_R); xf_mh_R = xf_hp_pass_R.lr4_run(comp_R);
      xf_mid_R = xf_lp_pass_R.lr4_run(xf_mh_R); xf_high_R = xf_lp_cut_R.lr4_run(xf_mh_R);
      xf_gap_R = xf_low_R + xf_high_R;
    ) : ( xf_gap_R = 0; xf_mid_R = comp_R; );
    f_sat_L = process_sat(xf_mid_L, mem_L[37], xf_foo_L) * xf_comp_L;
    f_sat_R = process_sat(xf_mid_R, mem_R[37], xf_foo_R) * xf_comp_R;

    // Parallel Summation (pure wet saturation delta over dry comp)
    comp_L = comp_L + ((t_sat_L - xt_mid_L) * xt_wet_v_L) + ((v_sat_L - xv_mid_L) * xv_wet_v_L) + ((f_sat_L - xf_mid_L) * xf_wet_v_L);
    comp_R = comp_R + ((t_sat_R - xt_mid_R) * xt_wet_v_R) + ((v_sat_R - xv_mid_R) * xv_wet_v_R) + ((f_sat_R - xf_mid_R) * xf_wet_v_R);
  ) : (
    // --- DELTA SERIES (3-Band Trees) ---
    // Post 1 (Tube)
    xt_filt_on_L ? (
      xt_low_L = xt_hp_cut_L.lr4_run(comp_L); xt_mh_L = xt_hp_pass_L.lr4_run(comp_L);
      xt_mid_L = xt_lp_pass_L.lr4_run(xt_mh_L); xt_high_L = xt_lp_cut_L.lr4_run(xt_mh_L);
      xt_gap_L = xt_low_L + xt_high_L;
    ) : ( xt_gap_L = 0; xt_mid_L = comp_L; );
    xt_filt_on_R ? (
      xt_low_R = xt_hp_cut_R.lr4_run(comp_R); xt_mh_R = xt_hp_pass_R.lr4_run(comp_R);
      xt_mid_R = xt_lp_pass_R.lr4_run(xt_mh_R); xt_high_R = xt_lp_cut_R.lr4_run(xt_mh_R);
      xt_gap_R = xt_low_R + xt_high_R;
    ) : ( xt_gap_R = 0; xt_mid_R = comp_R; );
    t_sat_L = process_sat(xt_mid_L, mem_L[35], xt_foo_L) * xt_comp_L;
    t_sat_R = process_sat(xt_mid_R, mem_R[35], xt_foo_R) * xt_comp_R;
    comp_L = xt_gap_L + (t_sat_L * xt_wet_v_L) + (xt_mid_L * (1.0 - xt_wet_v_L));
    comp_R = xt_gap_R + (t_sat_R * xt_wet_v_R) + (xt_mid_R * (1.0 - xt_wet_v_R));

    // Post 2 (VCA)
    xv_filt_on_L ? (
      xv_low_L = xv_hp_cut_L.lr4_run(comp_L); xv_mh_L = xv_hp_pass_L.lr4_run(comp_L);
      xv_mid_L = xv_lp_pass_L.lr4_run(xv_mh_L); xv_high_L = xv_lp_cut_L.lr4_run(xv_mh_L);
      xv_gap_L = xv_low_L + xv_high_L;
    ) : ( xv_gap_L = 0; xv_mid_L = comp_L; );
    xv_filt_on_R ? (
      xv_low_R = xv_hp_cut_R.lr4_run(comp_R); xv_mh_R = xv_hp_pass_R.lr4_run(comp_R);
      xv_mid_R = xv_lp_pass_R.lr4_run(xv_mh_R); xv_high_R = xv_lp_cut_R.lr4_run(xv_mh_R);
      xv_gap_R = xv_low_R + xv_high_R;
    ) : ( xv_gap_R = 0; xv_mid_R = comp_R; );
    v_sat_L = process_sat(xv_mid_L, mem_L[36], xv_foo_L) * xv_comp_L;
    v_sat_R = process_sat(xv_mid_R, mem_R[36], xv_foo_R) * xv_comp_R;
    comp_L = xv_gap_L + (v_sat_L * xv_wet_v_L) + (xv_mid_L * (1.0 - xv_wet_v_L));
    comp_R = xv_gap_R + (v_sat_R * xv_wet_v_R) + (xv_mid_R * (1.0 - xv_wet_v_R));

    // Post 3 (FET)
    xf_filt_on_L ? (
      xf_low_L = xf_hp_cut_L.lr4_run(comp_L); xf_mh_L = xf_hp_pass_L.lr4_run(comp_L);
      xf_mid_L = xf_lp_pass_L.lr4_run(xf_mh_L); xf_high_L = xf_lp_cut_L.lr4_run(xf_mh_L);
      xf_gap_L = xf_low_L + xf_high_L;
    ) : ( xf_gap_L = 0; xf_mid_L = comp_L; );
    xf_filt_on_R ? (
      xf_low_R = xf_hp_cut_R.lr4_run(comp_R); xf_mh_R = xf_hp_pass_R.lr4_run(comp_R);
      xf_mid_R = xf_lp_pass_R.lr4_run(xf_mh_R); xf_high_R = xf_lp_cut_R.lr4_run(xf_mh_R);
      xf_gap_R = xf_low_R + xf_high_R;
    ) : ( xf_gap_R = 0; xf_mid_R = comp_R; );
    f_sat_L = process_sat(xf_mid_L, mem_L[37], xf_foo_L) * xf_comp_L;
    f_sat_R = process_sat(xf_mid_R, mem_R[37], xf_foo_R) * xf_comp_R;
    comp_L = xf_gap_L + (f_sat_L * xf_wet_v_L) + (xf_mid_L * (1.0 - xf_wet_v_L));
    comp_R = xf_gap_R + (f_sat_R * xf_wet_v_R) + (xf_mid_R * (1.0 - xf_wet_v_R));
  );

  p_xt = max(abs(t_sat_L), abs(t_sat_R)); p_xt > env_xt ? env_xt += (p_xt - env_xt)*0.1 : env_xt *= 0.99;
  p_xv = max(abs(v_sat_L), abs(v_sat_R)); p_xv > env_xv ? env_xv += (p_xv - env_xv)*0.1 : env_xv *= 0.99;
  p_xf = max(abs(f_sat_L), abs(f_sat_R)); p_xf > env_xf ? env_xf += (p_xf - env_xf)*0.1 : env_xf *= 0.99;
) : (
  env_xt *= 0.99; env_xv *= 0.99; env_xf *= 0.99;
);

// Decode M/S Matrix
stereo_mode == 1 ? (
  final_L = comp_L + comp_R; final_R = comp_L - comp_R;
  comp_L = final_L; comp_R = final_R;
);

// --- STAGE 4: FINAL DRY/WET MIX & OPTIONAL CLIPPER ---
out_L = ((raw_in_L * dry_gain) + (comp_L * wet_gain)) * og_lin;
out_R = ((raw_in_R * dry_gain) + (comp_R * wet_gain)) * og_lin;

clipper_on == 1 ? ( spl0 = clamp(out_L, -1.0, 1.0); spl1 = clamp(out_R, -1.0, 1.0); ) : ( spl0 = out_L; spl1 = out_R; );

// --- NEW CLIPPER GAIN REDUCTION MATH ---
out_max = max(abs(out_L), abs(out_R));
clipper_on == 1 && out_max > 1.0 ? inst_clip_db = 20 * log10(out_max) : inst_clip_db = 0;

// 50ms smooth decay for the visual strip
inst_clip_db > clip_env_db ? clip_env_db = inst_clip_db : clip_env_db *= exp(-1 / (srate * 0.05));
// Hold the absolute peak for the text readout
inst_clip_db > clip_peak_db ? clip_peak_db = inst_clip_db;

edit_target == 2 ? min_gr = min(min_gr, linear_gr_R) : min_gr = min(min_gr, linear_gr_L);
gfx_gr = edit_target == 2 ? target_gr_R : target_gr_L;

// Visuals Write Buffer
vis_sig = max(abs(spl0), abs(spl1)); vis_sig > gfx_aud_env ? gfx_aud_env += (vis_sig - gfx_aud_env) * 0.08 : gfx_aud_env *= 0.995;
s_count += 1;
s_count >= samples_per_pixel ? (
  in_wave_buf[write_pos] = max_in; wave_buf[write_pos] = max_out; diff_buf[write_pos] = min_gr;
  write_pos = (write_pos + 1) % MAX_POINTS; s_count = 0; max_in = 0; max_out = 0; min_gr = 1;
) : (
  max_in = max(max_in, max(abs(raw_in_L), abs(raw_in_R))); max_out = max(max_out, max(abs(spl0), abs(spl1)));
);


@gfx 1400 780
// --- DYNAMIC SCALING ENGINE ---
base_w = 1400; base_h = 780; 
scale = max(min(gfx_w / base_w, gfx_h / base_h), 0.1); 
x_offs = (gfx_w - (base_w * scale)) / 2; y_offs = (gfx_h - (base_h * scale)) / 2;
